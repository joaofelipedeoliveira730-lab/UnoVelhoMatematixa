:root{--bg:#06122c;--bg2:#0b2c68;--panel:rgba(9,29,70,.68);--panel2:rgba(12,43,98,.72);--line:rgba(151,220,255,.22);--text:#f5fbff;--muted:#9cb7d9;--cyan:#48e6ff;--blue:#2385ff;--deep:#07173a;--green:#43e58a;--yellow:#ffd84d;--red:#ff5276;--purple:#9c6cff;--shadow:0 24px 70px rgba(0,0,0,.45);--motion:1}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text);background:#041027}body{overflow-x:hidden}button,input,select{font:inherit}button{cursor:pointer;color:inherit;border:0}input,select{color:var(--text)}.hidden{display:none!important}.screen{min-height:100vh}.glass{background:linear-gradient(135deg,rgba(17,52,114,.76),rgba(4,18,51,.72));border:1px solid var(--line);box-shadow:var(--shadow);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px)}.glass-inner{background:rgba(1,12,35,.42);border:1px solid rgba(160,225,255,.12);border-radius:22px}.muted{color:var(--muted)}

/* BOOT */
.boot-screen{position:fixed;inset:0;z-index:10000;background:radial-gradient(circle at 50% 30%,#1c78ff 0,#081e54 42%,#020914 100%);display:grid;place-items:center;align-content:center;gap:16px}.loader-logo{font-size:42px;font-weight:1000;letter-spacing:-3px;text-shadow:0 0 35px rgba(73,224,255,.65)}.loader-logo span{display:block;color:var(--cyan);font-size:13px;letter-spacing:7px;text-align:center}.loader-ring{width:54px;height:54px;border:4px solid rgba(255,255,255,.15);border-top-color:var(--cyan);border-radius:50%;animation:spin 1s linear infinite}.boot-screen p{color:#b7d7ff}@keyframes spin{to{transform:rotate(360deg)}}

/* AUTH */
.auth-screen{display:grid;place-items:center;padding:24px;overflow:hidden;position:relative;background:radial-gradient(circle at 20% 20%,rgba(42,137,255,.35),transparent 30%),radial-gradient(circle at 80% 70%,rgba(84,62,255,.3),transparent 30%),linear-gradient(145deg,#041331,#073f96 55%,#07132d)}.auth-screen:before,.auth-screen:after{content:"";position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(90px);opacity:.35}.auth-screen:before{background:#00b7ff;left:-180px;top:-160px}.auth-screen:after{background:#6738ff;right:-180px;bottom:-200px}.auth-shell{width:min(1050px,100%);padding:38px;border-radius:32px;position:relative;z-index:2}.auth-brand{display:flex;align-items:center;gap:13px}.logo-mark,.mini-logo{display:grid;place-items:center;background:linear-gradient(135deg,#fff,#a8f1ff);color:#0759bb;font-weight:1000;border-radius:16px;box-shadow:0 0 30px rgba(72,230,255,.35);transform:skew(-6deg)}.logo-mark{width:52px;height:52px;font-size:30px}.brand-title{font-weight:1000;letter-spacing:2px}.brand-sub{font-size:10px;letter-spacing:5px;color:var(--cyan);font-weight:900}.auth-copy{text-align:center;max-width:680px;margin:42px auto 25px}.auth-copy h1{font-size:clamp(44px,8vw,82px);line-height:.9;margin:14px 0;background:linear-gradient(180deg,#fff,#8beaff);-webkit-background-clip:text;color:transparent;letter-spacing:-5px}.auth-copy p{color:var(--muted);font-size:17px}.pill{display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:999px;border:1px solid rgba(72,230,255,.3);background:rgba(72,230,255,.08);color:#9af3ff;font-size:11px;font-weight:900;letter-spacing:1px}.auth-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.auth-form{padding:24px;border-radius:22px}.auth-form h2{margin:0 0 18px}.auth-form label,.modal label,.panel label{display:grid;gap:7px;color:#c6d8ef;font-size:12px;font-weight:800;margin-bottom:13px}.auth-form input,.modal input,.modal select,.panel input[type=range],.panel select{width:100%;background:rgba(2,12,32,.75);border:1px solid rgba(143,204,255,.18);border-radius:13px;padding:13px 14px;outline:none}.auth-form input:focus,.modal input:focus,.modal select:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(72,230,255,.08)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:13px;padding:12px 18px;font-weight:950;letter-spacing:.3px;transition:transform calc(.18s * var(--motion)),filter .18s,box-shadow .18s}.btn:hover{transform:translateY(-2px);filter:brightness(1.08)}.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}.btn-primary{background:linear-gradient(135deg,#1677ff,#28bfff);box-shadow:0 12px 28px rgba(25,134,255,.27)}.btn-cyan{background:linear-gradient(135deg,#00a9d8,#4ce9ff);color:#032342}.btn-secondary{background:rgba(121,167,222,.14);border:1px solid rgba(170,220,255,.17)}.btn-danger{background:linear-gradient(135deg,#d9335c,#ff5c78)}.btn-owned{background:rgba(68,229,138,.12);color:var(--green);border:1px solid rgba(68,229,138,.25);cursor:default}.btn-wide{width:100%}.form-message{min-height:20px;text-align:center;margin-top:9px;font-size:12px;font-weight:800}.form-message.success{color:var(--green)}.form-message.error{color:#ff7895}.auth-foot{text-align:center;color:#7696c0;font-size:11px;margin-top:22px}.floating-cards{position:absolute;inset:0;pointer-events:none}.float-card{position:absolute;width:75px;height:105px;border:2px solid rgba(255,255,255,.35);border-radius:12px;display:grid;place-items:center;color:#fff;background:rgba(255,255,255,.05);font-weight:1000;font-size:30px;transform:rotate(-15deg);opacity:.35;animation:floatCard 12s ease-in-out infinite}.f1{left:6%;top:13%}.f2{left:16%;bottom:8%;animation-delay:-2s}.f3{left:45%;top:5%;animation-delay:-4s}.f4{right:8%;top:18%;animation-delay:-6s}.f5{right:20%;bottom:10%;animation-delay:-8s}.f6{right:38%;top:32%;animation-delay:-3s}.f7{left:31%;bottom:8%;animation-delay:-5s}.f8{right:3%;bottom:38%;animation-delay:-7s}@keyframes floatCard{0%,100%{translate:0 0 rotate(-15deg)}50%{translate:30px -40px rotate(10deg)}}

/* TOP BAR */
.app-screen{background:radial-gradient(circle at 50% -20%,#1666d6 0,transparent 40%),linear-gradient(180deg,#061b42,#020b20);padding:14px;position:relative}.app-screen:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 10% 30%,rgba(44,187,255,.12),transparent 20%),radial-gradient(circle at 90% 60%,rgba(100,72,255,.1),transparent 25%)}.topbar{height:66px;max-width:1450px;margin:0 auto 14px;border-radius:18px;padding:8px 13px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:10px;z-index:100}.brand-button{display:flex;align-items:center;gap:9px;background:transparent;text-align:left}.brand-button b{font-size:13px;letter-spacing:1px}.brand-button small{display:block;font-size:8px;letter-spacing:3px;color:var(--cyan);font-weight:900}.mini-logo{width:40px;height:40px;font-size:22px;border-radius:12px}.top-actions{display:flex;align-items:center;gap:8px}.currency,.level-chip{height:40px;padding:0 13px;border-radius:12px;display:flex;align-items:center;gap:7px;background:rgba(0,0,0,.22);border:1px solid rgba(150,210,255,.13)}.currency b{color:#ffe78a}.level-chip{font-size:9px;color:#88b5e9}.level-chip b{font-size:16px;color:#fff}.avatar-mini{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#35bfff,#6c55ff);border:2px solid rgba(255,255,255,.7);display:grid;place-items:center}.icon-btn{width:40px;height:40px;border-radius:12px;background:rgba(0,0,0,.22);border:1px solid rgba(150,210,255,.13);font-size:17px}.view{max-width:1450px;margin:auto;position:relative;z-index:1}.subnav{display:flex;align-items:center;gap:14px;margin:8px 0 18px}.subnav h2{margin:0;font-size:27px;letter-spacing:-1px}.back-btn{background:transparent;color:#a8c9f4;font-weight:900;padding:8px}.subnav-actions{margin-left:auto;display:flex;gap:8px}.text-btn{background:transparent;color:#7fdcff;font-weight:900}.view{display:block}.view.hidden{display:none!important}

/* LOBBY */
.lobby-hero{min-height:610px;border-radius:32px;overflow:hidden;position:relative;padding:42px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;background:radial-gradient(circle at 20% 50%,rgba(64,225,255,.25),transparent 30%),radial-gradient(circle at 85% 20%,rgba(91,77,255,.25),transparent 25%),linear-gradient(145deg,rgba(13,83,175,.78),rgba(5,24,65,.86));border:1px solid rgba(119,224,255,.23);box-shadow:0 30px 100px rgba(0,40,130,.35)}.lobby-hero:before{content:"";position:absolute;inset:-30%;background:linear-gradient(115deg,transparent 45%,rgba(255,255,255,.05) 50%,transparent 55%);transform:translateX(-50%);animation:sheen 10s linear infinite}.lobby-hero:after{content:"";position:absolute;inset:0;background-image:radial-gradient(circle at 25% 70%,rgba(255,255,255,.15) 0 1px,transparent 2px);background-size:60px 60px;opacity:.35}.hero-copy,.hero-actions{position:relative;z-index:2}.hero-copy h1{font-size:clamp(48px,7vw,100px);line-height:.86;letter-spacing:-7px;margin:18px 0 12px}.hero-copy h1 span{display:block;color:#a3efff;text-shadow:0 0 25px rgba(72,230,255,.35)}.hero-copy p{font-size:17px;color:#a6c9ef;max-width:500px}.hero-profile{margin-top:34px;display:flex;align-items:center;gap:16px;width:max-content;max-width:100%;padding:10px 16px 10px 10px;border-radius:20px;background:rgba(2,11,31,.34);border:1px solid rgba(175,230,255,.14)}.hero-profile>b{font-size:15px}.hero-profile small{color:#8fb0d8}.xp-line{width:220px;height:8px;border-radius:99px;background:rgba(255,255,255,.09);margin:6px 0;overflow:hidden}.xp-line span{height:100%;display:block;border-radius:inherit;background:linear-gradient(90deg,#4ae3ff,#6c7bff);box-shadow:0 0 15px rgba(72,230,255,.55)}.character-stage{position:relative;width:120px;height:150px;display:grid;place-items:end center}.character-stage.small{width:80px;height:85px}.character-stage.large{width:250px;height:300px;margin:auto}.character-stage.huge{width:270px;height:340px}.hero-actions{display:grid;gap:14px;max-width:550px;justify-self:end;width:100%}.menu-btn{min-height:108px;border-radius:23px;text-align:left;padding:17px 22px;display:grid;grid-template-columns:60px 1fr;grid-template-rows:1fr 1fr;align-items:center;position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.2);box-shadow:0 18px 40px rgba(0,0,0,.2);transition:transform .18s,filter .18s}.menu-btn:hover{transform:translateX(-5px) scale(1.01);filter:brightness(1.08)}.menu-btn>span{grid-row:1/3;font-size:38px}.menu-btn b{font-size:24px}.menu-btn small{font-size:11px;opacity:.8}.menu-btn.play{background:linear-gradient(135deg,#1ecb63,#24f08c);color:#041b16}.menu-btn.shop{background:linear-gradient(135deg,#1b7cff,#25c9ff)}.menu-btn.inventory{background:linear-gradient(135deg,#744fff,#a27bff)}.menu-btn.customize{background:linear-gradient(135deg,#0d9fb9,#54f1ff);color:#03202a}.hero-cards{position:absolute;inset:0;pointer-events:none;z-index:1}.hero-cards div{position:absolute;width:82px;height:115px;border:2px solid rgba(255,255,255,.16);background:rgba(255,255,255,.04);border-radius:13px;display:grid;place-items:center;font-size:30px;font-weight:1000;color:rgba(255,255,255,.45);animation:floatCard 13s ease-in-out infinite}.hero-cards div:nth-child(1){right:45%;top:7%}.hero-cards div:nth-child(2){right:24%;top:25%;animation-delay:-2s}.hero-cards div:nth-child(3){right:10%;bottom:15%;animation-delay:-4s}.hero-cards div:nth-child(4){left:39%;bottom:8%;animation-delay:-6s}.hero-cards div:nth-child(5){left:7%;bottom:12%;animation-delay:-8s}.dashboard-grid{display:grid;grid-template-columns:1.1fr 1.4fr 1fr;gap:14px;margin-top:14px}.panel{border-radius:23px;padding:19px}.panel-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;font-weight:950}.mini-rank{display:grid;gap:7px}.rank-mini-row{display:grid;grid-template-columns:25px 1fr auto;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.06)}.rank-mini-row span{color:#7fdcff}.rank-mini-row small{color:#7d9ac1;font-size:9px}.map-preview{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.map-tile{height:112px;border-radius:16px;background:linear-gradient(135deg,#164b91,#091a3d);background-size:cover;background-position:center;display:flex;align-items:end;padding:10px;text-align:left;position:relative;overflow:hidden}.map-tile:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent,rgba(0,0,0,.75))}.map-tile b{position:relative;z-index:2;font-size:10px}.achievement-preview{display:grid;gap:8px}.achievement-chip{display:flex;align-items:center;gap:10px;padding:10px;border-radius:14px;background:rgba(255,255,255,.045)}.achievement-chip span{font-size:24px}.achievement-chip b{font-size:11px}
@keyframes sheen{0%{transform:translateX(-60%)}100%{transform:translateX(60%)}}

/* PLAY / ROOMS */
.play-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.mode-card,.difficulty{min-height:250px;border-radius:28px;padding:28px;text-align:left;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.16);box-shadow:var(--shadow);transition:transform .2s}.mode-card:hover,.difficulty:hover{transform:translateY(-7px)}.mode-card span,.difficulty span{font-size:55px;margin-bottom:auto}.mode-card b,.difficulty b{font-size:25px}.mode-card small,.difficulty small{color:#b9d4f5;margin-top:6px}.mode-card.solo{background:radial-gradient(circle at 80% 20%,#3cff9d55,transparent 35%),linear-gradient(145deg,#0b8c67,#061e36)}.mode-card.online{background:radial-gradient(circle at 80% 20%,#3fdcff55,transparent 35%),linear-gradient(145deg,#0b62bb,#091d53)}.mode-card.rank{background:radial-gradient(circle at 80% 20%,#a46cff55,transparent 35%),linear-gradient(145deg,#53329f,#141438)}.reference-strip{margin-top:16px;border-radius:22px;overflow:hidden;display:grid;grid-template-columns:1fr 1.3fr;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09)}.reference-strip div{padding:22px;display:flex;flex-direction:column;justify-content:center}.reference-strip small{color:#8faed4;margin-top:6px}.reference-strip img{width:100%;height:150px;object-fit:cover;opacity:.8}.difficulty-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.difficulty{min-height:280px}.difficulty.easy{background:linear-gradient(145deg,#087d5a,#061f33)}.difficulty.medium{background:linear-gradient(145deg,#a47512,#2a1c06)}.difficulty.hard{background:linear-gradient(145deg,#a52849,#2c0714)}.rooms-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.room-card{overflow:hidden;border-radius:22px}.room-cover{height:130px;background-size:cover;background-position:center;display:flex;align-items:flex-start;justify-content:flex-end;padding:12px;font-size:25px}.room-card-body{padding:16px}.room-card-body>b,.room-card-body>div:first-child>b{font-size:16px}.room-card-body small{display:block;color:#8faed4;margin:4px 0 10px}.room-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}.room-tags span{font-size:9px;padding:5px 7px;border-radius:99px;background:rgba(255,255,255,.07);color:#a9c8ec}.empty-state{min-height:280px;border-radius:24px;display:grid;place-items:center;align-content:center;gap:8px;text-align:center;padding:30px}.empty-state span{font-size:45px}.empty-state small{color:#89a6ca}

/* ROOM */
.room-layout{display:grid;grid-template-columns:1fr 350px;gap:14px}.room-main{border-radius:25px;padding:18px;min-height:560px}.room-options-bar{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-radius:16px;background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.08);color:#9fc3ea}.room-players{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:14px}.room-player{padding:14px;border-radius:18px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.06);display:grid;grid-template-columns:48px 1fr auto;align-items:center;gap:10px}.room-player.host{border-color:rgba(255,214,82,.3);box-shadow:inset 0 0 30px rgba(255,210,60,.03)}.player-avatar{width:42px;height:42px;border-radius:13px;background:linear-gradient(135deg,#227cff,#6b5aff);display:grid;place-items:center}.room-player small{display:block;color:#7f9bc1;font-size:9px;margin-top:2px}.room-player>span{color:var(--green);font-size:11px}.room-map-banner{margin-top:16px;min-height:280px;border-radius:22px;background-size:cover;background-position:center;display:flex;align-items:end;padding:20px;overflow:hidden;position:relative}.room-map-banner:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 30%,rgba(0,0,0,.75))}.room-map-banner div{position:relative;z-index:2;display:grid;gap:3px}.room-map-banner span{font-size:9px;color:#8eeeff;font-weight:900}.chat-panel{border-radius:23px;overflow:hidden;display:flex;flex-direction:column;min-height:560px}.chat-head{padding:15px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between}.chat-head span{color:var(--green);font-size:9px}.chat-messages{flex:1;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:7px}.chat-line{padding:8px 10px;border-radius:13px;background:rgba(255,255,255,.045);display:grid;gap:2px;max-width:95%}.chat-line.mine{align-self:flex-end;background:rgba(28,123,255,.18)}.chat-line b{font-size:10px;color:#76dfff}.chat-line span{font-size:12px;color:#dbeaff;word-break:break-word}.chat-form{padding:10px;border-top:1px solid rgba(255,255,255,.08);display:flex;gap:7px}.chat-form input{min-width:0;flex:1;background:rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:11px;outline:none}.chat-form button{width:44px;border-radius:12px;background:var(--blue)}

/* GAME */
.game-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:12px}.arena-shell{min-height:calc(100vh - 105px);border-radius:28px;overflow:hidden;position:relative;background:#1a0e08;border:1px solid rgba(255,255,255,.16);box-shadow:0 30px 100px rgba(0,0,0,.45)}.arena-bg{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 52%,rgba(63,218,166,.18),transparent 35%),linear-gradient(135deg,#25120b,#5a2415 45%,#1b0b07);z-index:0}.arena-reference{position:absolute;inset:0;background:radial-gradient(circle at 50% 45%,rgba(61,214,163,.16),transparent 35%),linear-gradient(135deg,#160c08,#5b2415 45%,#100806);opacity:1;mix-blend-mode:normal;z-index:0}.arena-card-reference{position:absolute;inset:0;background:radial-gradient(circle,rgba(255,255,255,.06) 1px,transparent 2px);background-size:28px 28px;opacity:.18;mix-blend-mode:screen;z-index:1;pointer-events:none}.arena-shell:after{content:"";position:absolute;inset:15%;border-radius:50%;border:2px solid rgba(77,255,196,.35);box-shadow:0 0 70px rgba(77,255,196,.08),inset 0 0 80px rgba(0,0,0,.2);pointer-events:none}.arena-top{position:relative;z-index:3;padding:15px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.game-stat{background:rgba(0,0,0,.35);padding:7px 11px;border-radius:12px;width:max-content}.game-stat span{font-size:8px;color:#a9c7e7;display:block}.game-stat b{font-size:11px}.turn-badge{padding:10px 18px;border-radius:999px;background:rgba(45,224,255,.12);border:1px solid rgba(72,230,255,.45);color:#9ef4ff;font-weight:1000;text-align:center;box-shadow:0 0 30px rgba(72,230,255,.12)}.turn-badge.bot{background:rgba(255,182,64,.1);border-color:rgba(255,182,64,.4);color:#ffd987}.arena-tools{display:flex;justify-content:flex-end;gap:6px}.opponents{position:relative;z-index:2;display:flex;justify-content:center;gap:8px;min-height:105px;padding:5px 20px;flex-wrap:wrap}.opponent-card{min-width:155px;padding:9px 12px;border-radius:16px;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.09);display:grid;grid-template-columns:40px 1fr;align-items:center;gap:8px}.opponent-card.active{border-color:var(--cyan);box-shadow:0 0 25px rgba(72,230,255,.12)}.opponent-avatar{width:36px;height:36px;border-radius:11px;background:linear-gradient(135deg,#fb8a45,#f43f69);display:grid;place-items:center}.opponent-card small{display:block;color:#9db7d8;font-size:9px}.mini-hand{grid-column:1/3;display:flex;overflow:hidden;padding-left:4px}.back-mini{width:24px;height:33px;margin-left:-7px;border-radius:5px;border:1px solid #fff;background:#111;color:#f2d21d;font-size:5px;display:grid;place-items:center}.table-center{position:relative;z-index:2;min-height:260px;display:flex;justify-content:center;align-items:center;gap:35px}.draw-stack{position:relative}.draw-stack>span{position:absolute;top:-12px;right:-12px;background:#071327;border:1px solid rgba(255,255,255,.2);padding:4px 7px;border-radius:8px;font-size:9px}.uno-card{width:75px;height:108px;border-radius:13px;border:3px solid #fff;box-shadow:0 12px 28px rgba(0,0,0,.42),inset 0 0 25px rgba(255,255,255,.08);display:grid;place-items:center;font-weight:1000;position:relative;user-select:none;transition:transform .18s,filter .18s;overflow:hidden}.uno-card:before{content:"";position:absolute;inset:8px;border:1px solid rgba(255,255,255,.5);border-radius:50%;transform:rotate(-28deg)}.uno-card span,.uno-card i,.uno-card em{position:relative;z-index:2;font-style:normal}.uno-card span{font-size:34px;text-shadow:2px 2px 0 rgba(0,0,0,.2)}.uno-card i{position:absolute;top:5px;left:7px;font-size:12px}.uno-card em{position:absolute;bottom:5px;right:7px;font-size:6px;opacity:.8}.uno-card:hover{transform:translateY(-12px) scale(1.04);filter:brightness(1.08)}.big-card{width:95px;height:138px;font-size:40px}.back-card{background:radial-gradient(circle,#f22b43 0 35%,#111 36% 70%,#f22b43 71%);color:#fff;font-size:20px}.card-red{background:linear-gradient(135deg,#ff4a61,#9d0d27)}.card-yellow{background:linear-gradient(135deg,#ffe86a,#c68b00);color:#111}.card-green{background:linear-gradient(135deg,#4af18c,#087d4b)}.card-blue{background:linear-gradient(135deg,#45cfff,#1251c8)}.card-black{background:linear-gradient(135deg,#0e1731,#02050d);border-color:#fff}.color-indicator{position:absolute;bottom:14px;left:50%;translate:-50% 0;font-size:9px;padding:5px 10px;border-radius:99px;background:rgba(0,0,0,.35);color:#cde7ff}.game-bottom{position:relative;z-index:3;padding:0 18px 18px}.player-self{display:flex;justify-content:space-between;align-items:center;max-width:980px;margin:auto}.self-profile{display:flex;align-items:center;gap:10px}.avatar-game{width:48px;height:58px;position:relative}.self-profile small{display:block;color:#a6c2e5;font-size:9px;margin-top:3px}.uno-call{background:linear-gradient(135deg,#ff3c64,#b4002d);border:2px solid #fff;padding:9px 22px;border-radius:99px;font-weight:1000;box-shadow:0 0 24px rgba(255,45,94,.25)}.hand-cards{display:flex;justify-content:center;align-items:end;gap:6px;min-height:140px;overflow-x:auto;padding:12px 4px 4px;scrollbar-width:thin}.hand-card{flex:0 0 72px}.hand-card:nth-child(odd){transform:rotate(-2deg)}.hand-card:nth-child(even){transform:rotate(2deg)}.hand-card:hover{transform:translateY(-16px) rotate(0)}.game-toast{height:25px;text-align:center;color:#bfe5ff;font-size:11px}.game-chat{min-height:calc(100vh - 105px);max-height:calc(100vh - 105px)}.chat-tabs{display:flex;border-bottom:1px solid rgba(255,255,255,.08)}.chat-tab{flex:1;background:transparent;padding:12px 4px;color:#7f9cc1;font-size:10px}.chat-tab.active{color:#fff;background:rgba(55,157,255,.12);box-shadow:inset 0 -2px var(--cyan)}.pause-banner{margin-bottom:10px;padding:12px 16px;border-radius:16px;background:linear-gradient(135deg,#ff304e,#8d1530);border:1px solid #ff7890;text-align:center;font-weight:1000;position:relative;z-index:20}.map-saloon .arena-bg{background:linear-gradient(135deg,#3b160d,#a2461f 45%,#2a0b06)}.map-classroom .arena-bg{background:linear-gradient(135deg,#071b2c,#174f69 50%,#061122)}.map-geometry .arena-bg{background:radial-gradient(circle at 50% 50%,#184a85,transparent 35%),linear-gradient(135deg,#0b1137,#061b46)}.map-neon .arena-bg{background:radial-gradient(circle at 50% 50%,#2e8cff44,transparent 25%),linear-gradient(135deg,#061337,#301a75)}.map-forest .arena-bg{background:radial-gradient(circle at 50% 50%,#2fcf6a22,transparent 35%),linear-gradient(135deg,#071c18,#0b3b2b)}.map-desert .arena-bg{background:linear-gradient(135deg,#3a1b0a,#b45a1b,#2a1207)}.map-ice .arena-bg{background:radial-gradient(circle,#4ce5ff44,transparent 35%),linear-gradient(135deg,#061b36,#125b88)}.map-space .arena-bg{background:radial-gradient(circle at 20% 30%,#fff 0 1px,transparent 2px),radial-gradient(circle at 70% 50%,#fff 0 1px,transparent 2px),linear-gradient(135deg,#020615,#15256b)}.map-math .arena-bg{background:radial-gradient(circle at 50% 50%,#54e8ff55,transparent 25%),linear-gradient(135deg,#071232,#442c96)}.map-ceo .arena-bg{background:radial-gradient(circle at 50% 40%,#ffda6540,transparent 30%),linear-gradient(135deg,#1a0d00,#68400a,#130900)}

/* SHOP */
.shop-tabs{margin-left:auto;display:flex;gap:5px;background:rgba(255,255,255,.04);padding:4px;border-radius:12px}.shop-tab{background:transparent;color:#88a6cc;padding:8px 12px;border-radius:9px;font-size:10px;font-weight:900}.shop-tab.active{background:rgba(54,157,255,.18);color:#fff}.item-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.item-card{border-radius:20px;overflow:hidden;display:flex;flex-direction:column}.item-visual{height:135px;display:grid;place-items:center;font-size:45px;background:radial-gradient(circle at 50% 20%,rgba(72,230,255,.25),transparent 50%),linear-gradient(145deg,#0e4388,#071b40)}.item-visual.saloon{background:linear-gradient(145deg,#7a351c,#1d0b06)}.item-visual.neon{background:linear-gradient(145deg,#1435b7,#6414ad)}.item-visual.geometry{background:linear-gradient(145deg,#086b8e,#131a78)}.item-visual.gold,.item-visual.legendary{background:linear-gradient(145deg,#7a4a08,#e6b62c,#3a2103)}.item-info{padding:14px;display:grid;gap:5px}.item-category{font-size:8px;text-transform:uppercase;color:#70ddff;font-weight:900}.item-info>b{font-size:13px}.item-info>small{color:#7f9fc5;font-size:10px;min-height:28px}.item-buy{display:flex;justify-content:space-between;align-items:center;margin-top:7px;font-size:10px;color:#b9d3f1}.item-buy .btn{padding:8px 9px;font-size:9px}.rarity-legendary{border-color:rgba(255,214,80,.3)}.rarity-epic{border-color:rgba(160,105,255,.3)}.rarity-rare{border-color:rgba(72,230,255,.22)}

/* INVENTORY / RANK / SETTINGS */
.profile-layout{display:grid;grid-template-columns:320px 1fr;gap:14px}.profile-card{border-radius:25px;padding:24px;text-align:center}.profile-card h3{margin:5px 0 8px}.title-badge{display:inline-flex;padding:6px 9px;border-radius:99px;background:rgba(72,230,255,.1);color:#8ceeff;border:1px solid rgba(72,230,255,.2);font-size:9px;font-weight:1000}.profile-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px}.profile-stats div{padding:10px;border-radius:13px;background:rgba(255,255,255,.04)}.profile-stats b{display:block;font-size:18px}.profile-stats small{color:#7897bd;font-size:8px}.inventory-panel{border-radius:25px;padding:18px}.inventory-tabs{display:flex;gap:7px;margin-bottom:16px}.inventory-tab{padding:9px 12px;border-radius:11px;background:rgba(255,255,255,.04);color:#8ca8cd;font-weight:900;font-size:10px}.inventory-tab.active{background:rgba(36,136,255,.16);color:#fff}.inventory-section{margin-bottom:18px}.inventory-section h3{font-size:11px;color:#76ddff;letter-spacing:1px}.inventory-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.owned-item{padding:12px;border-radius:15px;background:rgba(255,255,255,.04);display:grid;gap:4px}.owned-icon{font-size:25px}.owned-item b{font-size:10px}.owned-item small{font-size:8px;color:#6f8db4}.achievement-list{display:grid;gap:9px}.achievement-card{display:grid;grid-template-columns:50px 1fr auto;align-items:center;gap:12px;padding:13px;border-radius:16px;background:rgba(255,255,255,.04)}.achievement-card>span{font-size:28px}.achievement-card b{display:block}.achievement-card small{color:#7e9abd;font-size:9px}.achievement-card em{font-size:8px;color:#7cdfff;font-style:normal}.rank-table{border-radius:23px;overflow:hidden}.rank-head,.rank-row{display:grid;grid-template-columns:60px 1fr 120px 150px 120px;gap:10px;align-items:center;padding:13px 18px}.rank-head{background:rgba(55,160,255,.12);font-size:9px;color:#79a6d5;font-weight:900}.rank-row{border-top:1px solid rgba(255,255,255,.05);font-size:12px}.rank-row.me{background:rgba(53,206,255,.08)}.rank-row span:not(:first-child){color:#91afd3}.settings-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.settings-grid .panel{min-height:260px}.toggle-row{display:flex!important;align-items:center;justify-content:space-between!important;grid-template-columns:1fr auto!important;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.05)}.toggle-row input{width:40px!important;height:22px;accent-color:#2ab9ff}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form-grid .full{grid-column:1/-1}.modal-overlay{position:fixed;inset:0;z-index:5000;background:rgba(0,7,22,.76);display:grid;place-items:center;padding:18px;backdrop-filter:blur(14px)}.modal{max-height:92vh;overflow:auto;width:min(680px,100%);border-radius:27px;padding:24px;background:linear-gradient(145deg,rgba(13,45,101,.96),rgba(3,15,38,.98));border:1px solid rgba(135,216,255,.25);box-shadow:0 30px 100px rgba(0,0,0,.6)}.modal-wide{width:min(900px,100%)}.modal-narrow{width:min(450px,100%);text-align:center}.modal-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px}.modal-head h2{margin:8px 0 0}.close-modal{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.06);font-size:22px}.modal-icon,.math-icon{font-size:45px;margin-bottom:7px}.check-row{display:flex!important;grid-template-columns:18px 1fr!important;align-items:center;gap:10px;text-align:left;margin:18px 0}.check-row input{width:18px!important}.custom-layout{display:grid;grid-template-columns:300px 1fr;gap:20px}.custom-preview{min-height:520px;border-radius:22px;background:radial-gradient(circle at 50% 35%,rgba(72,230,255,.16),transparent 35%),linear-gradient(180deg,#0c3874,#07172f);display:grid;place-items:center;align-content:center;position:sticky;top:0}.custom-controls{display:grid;gap:12px}.control-section{padding:14px;border-radius:18px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06)}.control-section>b{display:block;margin-bottom:11px}.option-row{display:flex;gap:8px;margin-bottom:10px}.swatch{width:34px;height:34px;border-radius:50%;border:2px solid #fff;box-shadow:0 3px 10px rgba(0,0,0,.3)}

/* CHARACTER CSS */
.char-body{position:relative;width:80px;height:125px;filter:drop-shadow(0 12px 10px rgba(0,0,0,.25));--skin:#d59b76;--eyes:#1d2433}.character-stage.large .char-body{transform:scale(1.45)}.character-stage.huge .char-body{transform:scale(1.8)}.char-head{position:absolute;left:12px;top:3px;width:56px;height:63px;background:var(--skin);border-radius:45% 45% 42% 42%;z-index:4;box-shadow:inset 0 -8px 12px rgba(0,0,0,.08)}.char-eye{position:absolute;top:31px;width:6px;height:8px;border-radius:50%;background:var(--eyes)}.char-eye.left{left:15px}.char-eye.right{right:15px}.char-mouth{position:absolute;left:24px;top:46px;width:10px;height:4px;border-bottom:2px solid rgba(60,20,20,.6);border-radius:50%}.char-hair{position:absolute;inset:-5px -4px 22px;border-radius:50% 50% 35% 35%;background:var(--hair);z-index:5}.hair_basic{clip-path:polygon(0 0,100% 0,95% 52%,72% 45%,50% 58%,28% 45%,5% 58%)}.hair_curl{border-radius:45%;box-shadow:inset 8px 0 var(--hair),inset -8px 0 var(--hair)}.hair_long{border-radius:48% 48% 25% 25%;inset:-5px -8px 5px}.hair_mohawk{clip-path:polygon(0 40%,22% 0,35% 38%,50% 0,65% 38%,80% 0,100% 40%,88% 60%,12% 60%)}.hair_afro{inset:-11px -10px 10px;border-radius:50%}.hair_braids:before,.hair_braids:after{content:"";position:absolute;top:35px;width:15px;height:55px;background:var(--hair);border-radius:10px}.hair_braids:before{left:-4px}.hair_braids:after{right:-4px}.hair_ice{clip-path:polygon(0 30%,15% 0,32% 30%,45% 0,60% 25%,75% 0,100% 30%,90% 60%,10% 60%)}.hair_ceo{clip-path:polygon(0 45%,15% 10%,35% 38%,50% 0,65% 38%,85% 10%,100% 45%,88% 62%,12% 62%)}.char-torso{position:absolute;left:10px;top:59px;width:60px;height:46px;border-radius:18px 18px 9px 9px;background:#1e74d8;z-index:3}.shirt_red{background:#c5284b}.shirt_neon{background:#16b8d7;box-shadow:0 0 15px #25e5ff66}.shirt_gold{background:#c99619}.shirt_space{background:#dceaff}.char-bottom{position:absolute;left:18px;top:101px;width:44px;height:22px;border-radius:4px;background:#172a55;z-index:2}.pants_black{background:#101219}.pants_neon{background:#13bcd1}.char-shoes{position:absolute;left:14px;top:118px;width:22px;height:8px;background:#f2f6ff;border-radius:8px;box-shadow:30px 0 #f2f6ff;z-index:1}.shoes_red{background:#e53950;box-shadow:30px 0 #e53950}.shoes_gold{background:#e2b52b;box-shadow:30px 0 #e2b52b}.char-accessory{position:absolute;inset:0;z-index:7}.glasses_basic:before,.glasses_basic:after,.glasses_cyan:before,.glasses_cyan:after,.glasses_gold:before,.glasses_gold:after{content:"";position:absolute;top:28px;width:19px;height:13px;border:2px solid #111;border-radius:50%}.glasses_basic:before,.glasses_cyan:before,.glasses_gold:before{left:11px}.glasses_basic:after,.glasses_cyan:after,.glasses_gold:after{right:11px}.glasses_cyan:before,.glasses_cyan:after{border-color:#45efff;box-shadow:0 0 8px #45efff}.glasses_gold:before,.glasses_gold:after{border-color:#e9c441}.hat_cap:before{content:"";position:absolute;top:-1px;left:2px;width:65px;height:15px;border-radius:20px 20px 5px 5px;background:#1b68cf;transform:rotate(-5deg)}.hat_cowboy:before{content:"";position:absolute;top:-2px;left:-3px;width:70px;height:14px;background:#7b4a28;border-radius:50%;box-shadow:inset 0 4px #a86c3e}.hat_crown:before{content:"👑";position:absolute;top:-26px;left:17px;font-size:24px}.mask_math:before{content:"π";position:absolute;top:36px;left:23px;width:34px;height:20px;background:#13233c;color:#67eaff;border-radius:8px;display:grid;place-items:center}.backpack_blue:before,.backpack_space:before{content:"";position:absolute;left:-2px;top:61px;width:18px;height:44px;background:#195db7;border-radius:9px}.backpack_space:before{background:#6934c5}.char-aura{position:absolute;inset:15px -25px -15px;border-radius:50%;filter:blur(10px);opacity:.2;background:#46e8ff}.aura_gold{background:#ffcf3f}.aura_rainbow{background:linear-gradient(90deg,#ff4c6e,#ffe24d,#45efad,#52caff,#9d6bff)}

/* MAP VISUALS */
.map-classroom{background-image:linear-gradient(180deg,rgba(1,8,24,.08),rgba(1,8,24,.58)),url('assets/maps/classroom.svg')}.map-saloon{background-image:linear-gradient(180deg,rgba(1,8,24,.08),rgba(1,8,24,.58)),url('assets/maps/saloon.svg')}.map-geometry{background-image:linear-gradient(180deg,rgba(1,8,24,.08),rgba(1,8,24,.58)),url('assets/maps/geometry.svg')}.map-neon{background-image:linear-gradient(180deg,rgba(1,8,24,.08),rgba(1,8,24,.58)),url('assets/maps/neon.svg')}.map-forest{background-image:linear-gradient(180deg,rgba(1,8,24,.08),rgba(1,8,24,.58)),url('assets/maps/forest.svg')}.map-desert{background-image:linear-gradient(180deg,rgba(1,8,24,.08),rgba(1,8,24,.58)),url('assets/maps/desert.svg')}.map-ice{background-image:linear-gradient(180deg,rgba(1,8,24,.08),rgba(1,8,24,.58)),url('assets/maps/ice.svg')}.map-space{background-image:linear-gradient(180deg,rgba(1,8,24,.08),rgba(1,8,24,.58)),url('assets/maps/space.svg')}.map-math{background-image:linear-gradient(180deg,rgba(1,8,24,.08),rgba(1,8,24,.58)),url('assets/maps/math.svg')}.map-ceo{background-image:linear-gradient(180deg,rgba(1,8,24,.08),rgba(1,8,24,.58)),url('assets/maps/ceo.svg')}

/* TOASTS */
.toast-container{position:fixed;right:18px;bottom:18px;z-index:9000;display:grid;gap:8px;max-width:min(420px,calc(100vw - 36px))}.toast{display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:14px;background:rgba(7,20,49,.92);border:1px solid rgba(121,216,255,.2);box-shadow:0 15px 45px rgba(0,0,0,.45);animation:toastIn .25s ease;color:#e8f6ff;font-size:12px}.toast.success{border-color:rgba(68,229,138,.35)}.toast.error{border-color:rgba(255,82,118,.4)}.toast.out{opacity:0;transform:translateY(12px);transition:.35s}@keyframes toastIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

/* RESPONSIVE */
@media(max-width:1150px){.lobby-hero{grid-template-columns:1fr}.hero-actions{justify-self:stretch;grid-template-columns:1fr 1fr}.dashboard-grid{grid-template-columns:1fr 1fr}.dashboard-grid .panel:last-child{grid-column:1/-1}.item-grid{grid-template-columns:repeat(3,1fr)}.rooms-list{grid-template-columns:repeat(2,1fr)}.settings-grid{grid-template-columns:1fr 1fr}.settings-grid .panel:last-child{grid-column:1/-1}.game-layout{grid-template-columns:1fr}.game-chat{display:none}.arena-shell{min-height:calc(100vh - 105px)}}
@media(max-width:760px){.app-screen{padding:8px}.topbar{top:5px;height:58px}.top-actions{gap:5px}.currency,.level-chip{height:36px;padding:0 8px}.currency b{font-size:11px}.level-chip span{display:none}.icon-btn,.avatar-mini{width:36px;height:36px}.lobby-hero{padding:25px 17px;min-height:720px}.hero-copy h1{font-size:60px;letter-spacing:-5px}.hero-actions{grid-template-columns:1fr 1fr;gap:9px}.menu-btn{min-height:110px;padding:13px}.menu-btn>span{font-size:30px}.menu-btn b{font-size:16px}.menu-btn small{font-size:9px}.dashboard-grid{grid-template-columns:1fr}.dashboard-grid .panel:last-child{grid-column:auto}.map-preview{grid-template-columns:repeat(2,1fr)}.play-grid,.difficulty-grid{grid-template-columns:1fr}.mode-card,.difficulty{min-height:180px}.rooms-list{grid-template-columns:1fr}.room-layout{grid-template-columns:1fr}.room-chat{display:none}.room-main{min-height:520px}.room-players{grid-template-columns:1fr}.item-grid{grid-template-columns:repeat(2,1fr)}.profile-layout{grid-template-columns:1fr}.inventory-grid{grid-template-columns:repeat(3,1fr)}.settings-grid{grid-template-columns:1fr}.settings-grid .panel:last-child{grid-column:auto}.rank-head,.rank-row{grid-template-columns:35px 1fr 55px 80px 60px;padding:11px 10px;font-size:9px}.rank-row{font-size:10px}.form-grid{grid-template-columns:1fr}.form-grid .full{grid-column:auto}.custom-layout{grid-template-columns:1fr}.custom-preview{min-height:300px;position:relative}.custom-controls{grid-row:1}.modal{padding:17px}.custom-layout .custom-preview{grid-row:2}.game-layout{gap:0}.arena-shell{border-radius:20px;min-height:calc(100vh - 80px)}.arena-top{grid-template-columns:1fr auto 1fr;padding:8px}.turn-badge{font-size:10px;padding:8px 12px}.opponents{min-height:90px;padding:4px 8px}.opponent-card{min-width:120px}.table-center{min-height:220px;gap:15px}.big-card{width:82px;height:120px}.uno-card{width:66px;height:96px}.hand-cards{justify-content:flex-start;padding-left:12px}.hand-card{flex-basis:62px}.player-self{padding:0 5px}.game-bottom{padding:0 8px 8px}.self-profile b{font-size:11px}.uno-call{padding:8px 15px}.reference-strip{grid-template-columns:1fr}.reference-strip img{height:120px}.auth-shell{padding:22px}.auth-grid{grid-template-columns:1fr}.auth-copy{margin-top:30px}.auth-copy h1{font-size:54px}.auth-copy p{font-size:14px}.float-card{width:55px;height:78px;font-size:23px}.subnav{flex-wrap:wrap}.subnav-actions{width:100%;margin-left:0}.shop-tabs{margin-left:0;width:100%}.shop-tab{flex:1}.room-options-bar{align-items:flex-start;gap:10px}.room-options-bar .btn{font-size:10px;padding:9px}.profile-card{padding:17px}.character-stage.large{width:190px;height:250px}.character-stage.huge{width:230px;height:300px}}
@media(max-width:390px){.topbar .brand-button b{font-size:10px}.brand-button small{letter-spacing:2px}.hero-copy h1{font-size:50px}.hero-actions{grid-template-columns:1fr}.menu-btn{min-height:92px}.currency{display:none}.map-preview{grid-template-columns:1fr 1fr}.item-grid{grid-template-columns:1fr}.inventory-grid{grid-template-columns:repeat(2,1fr)}.table-center{min-height:185px}.opponent-card{min-width:100px}.opponent-card:nth-child(n+3){display:none}.hand-card{flex-basis:58px}.uno-card{width:60px;height:88px}.big-card{width:74px;height:108px}.draw-stack .uno-card{width:60px;height:88px}.turn-badge{padding:7px 8px;font-size:9px}}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
.mini-sell{justify-self:start;padding:5px 7px;border-radius:8px;background:rgba(36,136,255,.14);color:#7ddfff;font-size:8px;font-weight:900;border:1px solid rgba(72,230,255,.15)}

/* AUTH / FIRST ACCESS POLISH */
.terms-first{background:radial-gradient(circle at 50% 25%,rgba(52,180,255,.18),rgba(1,7,22,.88) 58%),rgba(1,7,22,.84)}
.terms-card{position:relative;overflow:hidden;text-align:center;padding:34px 30px 27px;box-shadow:0 0 90px rgba(42,155,255,.24),var(--shadow)}
.terms-card .terms-glow{position:absolute;width:260px;height:260px;border-radius:50%;background:#28c7ff;filter:blur(90px);opacity:.18;left:50%;top:-140px;transform:translateX(-50%);pointer-events:none}
.terms-icon{position:relative;z-index:1;animation:termsFloat 2.8s ease-in-out infinite}
.terms-card h2{position:relative;z-index:1;font-size:clamp(28px,6vw,42px);margin:12px 0 10px}
.terms-card p{position:relative;z-index:1;color:#b8cfee;line-height:1.65;margin:0 auto 18px;max-width:600px}
.download-preview{position:relative;z-index:1;display:flex;align-items:center;gap:12px;text-align:left;padding:13px 15px;margin:14px 0;border-radius:16px;background:rgba(74,194,255,.08);border:1px solid rgba(72,230,255,.16)}
.download-preview>span{font-size:26px}.download-preview div{display:grid;gap:2px;flex:1}.download-preview b{font-size:13px}.download-preview small{font-size:10px;color:#8eadd3}.download-preview strong{font-size:10px;color:#6ff1ff;letter-spacing:1px}.terms-note{display:block;margin-top:12px;color:#7694bc;font-size:10px}
@keyframes termsFloat{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-7px) rotate(2deg)}}
.auth-grid{grid-template-columns:minmax(0,520px);justify-content:center;gap:12px}.auth-divider{display:flex;align-items:center;gap:12px;color:#6f92bf;font-size:9px;font-weight:950;letter-spacing:1.8px}.auth-divider:before,.auth-divider:after{content:"";height:1px;flex:1;background:linear-gradient(90deg,transparent,rgba(126,201,255,.25))}.auth-divider:after{background:linear-gradient(90deg,rgba(126,201,255,.25),transparent)}.auth-form{padding:25px}.auth-register-form{background:linear-gradient(135deg,rgba(0,174,221,.09),rgba(1,12,35,.44))}.form-kicker{font-size:9px;color:#74eaff;font-weight:950;letter-spacing:1.8px;margin-bottom:7px}.auth-form h2{font-size:24px}.auth-submit{min-height:48px}.auth-screen .auth-shell{max-height:calc(100vh - 34px);overflow:auto;scrollbar-width:thin}
@media(max-width:760px){.terms-card{padding:26px 18px 21px}.terms-card p{font-size:13px}.auth-screen{padding:10px}.auth-shell{padding:18px 14px;border-radius:24px;max-height:calc(100vh - 18px)}.auth-copy{margin:24px auto 18px}.auth-copy h1{font-size:48px}.auth-copy p{font-size:13px}.auth-form{padding:19px}.auth-form h2{font-size:21px}}

/* FRONTEND REFORM — navegação e acessibilidade */
.auth-tabs{display:flex;gap:8px;margin:0 auto 14px;max-width:520px;padding:4px;background:rgba(255,255,255,.04);border-radius:14px}.auth-tab{flex:1;padding:11px;border-radius:10px;background:transparent;color:#8ba9cf;font-weight:950;font-size:10px}.auth-tab.active{background:rgba(40,155,255,.2);color:#fff}.test-account{text-align:center;color:#7897bd;font-size:10px;margin-top:12px}.test-account b{color:#9eefff}.boot-screen{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;align-content:center;gap:14px;background:radial-gradient(circle at 50% 40%,#176fe7,#03133a 58%,#020914);color:#dff7ff}.boot-screen.hidden{display:none!important}.loader-logo{font-size:52px;font-weight:1000;line-height:.8}.loader-logo span{display:block;font-size:18px;letter-spacing:9px;color:#54e9ff;text-align:center;margin-top:13px}.loader-ring{width:66px;height:66px;border:7px solid rgba(255,255,255,.13);border-top-color:#48e6ff;border-radius:50%;animation:spin 1s linear infinite}.boot-screen p{color:#a8c9ec}@keyframes spin{to{transform:rotate(360deg)}}.code-badge{margin-left:auto;padding:7px 10px;border-radius:10px;background:rgba(255,255,255,.07);color:#7fe7ff;font-size:10px;font-weight:950}.mode-card,.difficulty{border:1px solid rgba(160,220,255,.16);border-radius:24px;background:linear-gradient(145deg,rgba(20,74,150,.7),rgba(4,20,50,.8));padding:28px;min-height:170px;text-align:left;display:grid;align-content:center;gap:7px;transition:.18s}.mode-card:hover,.difficulty:hover{transform:translateY(-4px);filter:brightness(1.1)}.mode-card>span,.difficulty>span{font-size:42px}.mode-card b,.difficulty b{font-size:20px}.mode-card small,.difficulty small{color:#8ba8ce}.play-grid,.difficulty-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.rooms-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.room-card{border-radius:22px;overflow:hidden}.room-cover{height:150px;background-size:cover;background-position:center;display:grid;place-items:center;font-size:42px}.room-card-body{padding:15px;display:grid;gap:9px}.room-card-body small{display:block;color:#86a6cc;margin-top:3px}.room-tags{display:flex;gap:5px;flex-wrap:wrap}.room-tags span{font-size:8px;padding:5px 7px;border-radius:8px;background:rgba(255,255,255,.06);color:#9bc2eb}.empty-state{padding:30px;text-align:center;color:#8ba8ce;display:grid;gap:8px;place-items:center}.empty-state span{font-size:36px}.color-picker{display:grid;grid-template-columns:1fr 1fr;gap:8px}.color-picker button{padding:14px;border-radius:13px;font-weight:1000}.color-picker button[data-color=red]{background:#d92d4a}.color-picker button[data-color=yellow]{background:#d8a91b;color:#111}.color-picker button[data-color=green]{background:#13985a}.color-picker button[data-color=blue]{background:#2479dd}.modal label input,.modal label select{margin-top:0}.char-body{position:relative;width:100px;height:150px;display:grid;place-items:center}.char-head{position:absolute;top:10px;width:70px;height:70px;border-radius:50%;background:var(--skin);z-index:3;border:2px solid rgba(0,0,0,.2)}.char-eye{position:absolute;top:31px;width:7px;height:9px;border-radius:50%;background:var(--eyes)}.char-eye.left{left:20px}.char-eye.right{right:20px}.char-mouth{position:absolute;left:29px;top:49px;width:13px;height:5px;border-bottom:2px solid #6c3028;border-radius:50%}.char-hair{position:absolute;inset:-4px -3px auto;height:34px;background:var(--hair);border-radius:50px 50px 18px 18px;z-index:4}.char-torso,.char-bottom,.char-shoes,.char-accessory{position:absolute;z-index:2}.char-torso{top:76px;width:76px;height:55px;border-radius:18px 18px 10px 10px;background:#2586d9}.char-bottom{top:122px;width:65px;height:30px;background:#273d62;border-radius:8px}.char-shoes{top:145px;width:74px;height:13px;background:#111;border-radius:10px}.shirt_red{background:#d93c51}.shirt_neon{background:#18d9df}.shirt_gold{background:#d7a82b}.shirt_space{background:#5a56c9}.pants_black{background:#111}.pants_neon{background:#0eb8c5}.shoes_red{background:#bd3349}.shoes_gold{background:#d6a52d}.glasses_basic:before,.glasses_basic:after,.glasses_cyan:before,.glasses_cyan:after,.glasses_gold:before,.glasses_gold:after{content:"";position:absolute;top:31px;width:20px;height:14px;border:2px solid #111;border-radius:50%;z-index:5}.glasses_basic:before,.glasses_cyan:before,.glasses_gold:before{left:10px}.glasses_basic:after,.glasses_cyan:after,.glasses_gold:after{right:10px}.glasses_cyan:before,.glasses_cyan:after{border-color:#45efff}.glasses_gold:before,.glasses_gold:after{border-color:#e9c441}.hat_crown:before{content:"👑";position:absolute;top:-28px;left:25px;font-size:25px;z-index:6}.aura_gold{background:#ffcf3f}.aura_rainbow{background:linear-gradient(90deg,#ff4c6e,#ffe24d,#45efad,#52caff,#9d6bff)}
@media(max-width:760px){.play-grid,.difficulty-grid,.rooms-list{grid-template-columns:1fr}.auth-tabs{max-width:none}.code-badge{margin-left:0}.topbar{z-index:1000}.view{min-height:calc(100vh - 90px)}.lobby-hero{min-height:auto}.hero-actions{grid-template-columns:1fr 1fr}.hero-copy h1{font-size:52px}.item-grid{grid-template-columns:1fr 1fr}}

/* ==========================================================
   UNO VELHO MATEMATIXA — MESA 3D / LANDSCAPE / PLATAFORMA
   ========================================================== */
:root{--table:#6b2815;--felt:#145b4c;--gold:#f3c85b;--cyan:#55eaff;--night:#020816}
html,body{min-height:100%;margin:0;overflow-x:hidden}
body{background:#020816}
.hidden{display:none!important}
button,input,select{font:inherit}

/* escolha da plataforma */
.platform-screen{position:fixed;inset:0;z-index:20000;display:grid;place-items:center;padding:22px;background:radial-gradient(circle at 50% 25%,#0d68e9 0,#061e4e 42%,#020816 82%);overflow:auto}
.platform-card{width:min(900px,94vw);padding:42px;border-radius:34px;text-align:center;border:1px solid rgba(130,220,255,.2);box-shadow:0 30px 100px rgba(0,0,0,.5),0 0 90px rgba(21,122,255,.16)}
.platform-logo{display:flex;justify-content:center;align-items:center;gap:12px;font-weight:1000;letter-spacing:2px;font-size:28px}.platform-logo>span{display:grid;place-items:center;width:58px;height:58px;border-radius:17px;background:linear-gradient(145deg,#eafcff,#49d9ff);color:#0754b9;box-shadow:0 8px 30px rgba(72,220,255,.25)}.platform-logo small{display:block;color:#55eaff;font-size:10px;letter-spacing:6px;margin-top:5px}
.platform-kicker{margin-top:32px;color:#66eaff;font-size:10px;font-weight:1000;letter-spacing:2px}.platform-card h1{font-size:clamp(30px,5vw,58px);margin:9px 0}.platform-card>p{max-width:650px;margin:0 auto 28px;color:#a9c8ea;line-height:1.6}
.platform-options{display:grid;grid-template-columns:1fr 1fr;gap:16px}.platform-option{min-height:210px;border:1px solid rgba(135,218,255,.16);border-radius:28px;padding:25px;background:linear-gradient(145deg,rgba(24,91,177,.8),rgba(3,22,53,.94));color:#fff;text-align:left;display:grid;align-content:center;gap:8px;cursor:pointer;transition:.22s;box-shadow:inset 0 1px rgba(255,255,255,.08),0 15px 35px rgba(0,0,0,.2)}.platform-option:hover,.platform-option:focus-visible{transform:translateY(-6px) scale(1.01);border-color:rgba(81,232,255,.65);box-shadow:0 18px 45px rgba(0,130,255,.25)}.platform-option.mobile{background:linear-gradient(145deg,rgba(17,122,203,.86),rgba(5,34,78,.96))}.platform-option.computer{background:linear-gradient(145deg,rgba(31,75,157,.86),rgba(4,20,50,.96))}.platform-icon{font-size:55px}.platform-option b{font-size:22px;letter-spacing:1px}.platform-option small{color:#a6c9ea;line-height:1.4}.platform-note{display:block;margin-top:18px;color:#6e8eb8;font-size:10px}

/* tela de partida */
body.in-game{overflow:hidden}.game-view{position:fixed!important;inset:0;z-index:9000;width:100vw;height:100dvh;min-height:100dvh!important;padding:0!important;background:#03070f;overflow:hidden}
.game-stage-3d{width:100%;height:100%;display:grid;grid-template-columns:minmax(210px,270px) minmax(0,1fr);gap:10px;padding:10px;box-sizing:border-box;background:radial-gradient(circle at 60% 45%,rgba(31,104,165,.12),transparent 38%),#02060d}
.game-chat-left{min-width:0;height:100%;box-sizing:border-box;display:flex;flex-direction:column;overflow:hidden;z-index:20;background:linear-gradient(180deg,rgba(4,17,38,.94),rgba(2,8,20,.97));border-radius:20px!important;border:1px solid rgba(91,199,255,.16);box-shadow:0 20px 60px rgba(0,0,0,.45)}.game-chat-left .chat-head{padding:14px}.game-chat-left .chat-tabs{padding:0 10px 8px}.game-chat-left .chat-messages{flex:1;min-height:0}.game-chat-left .chat-form{margin:10px}
.arena-3d{position:relative;min-width:0;height:100%;overflow:hidden;border-radius:24px;border:1px solid rgba(255,210,130,.18);background:#1b0d08;box-shadow:0 30px 80px rgba(0,0,0,.55),inset 0 1px rgba(255,255,255,.08)}
.saloon-map{position:absolute;inset:0;background-image:radial-gradient(circle at 50% 55%,rgba(72,230,255,.12),transparent 28%),linear-gradient(135deg,#140b08,#4a1d13 48%,#0c0706);filter:saturate(1.05) contrast(1.08);z-index:0}.saloon-map:after{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 53% 56%,transparent 0 25%,rgba(0,0,0,.25) 65%,rgba(0,0,0,.72) 100%),linear-gradient(180deg,rgba(0,0,0,.18),transparent 35%,rgba(0,0,0,.45));pointer-events:none}
.map-light{position:absolute;width:35%;height:30%;left:34%;top:12%;border-radius:50%;background:#ffc66d;filter:blur(75px);opacity:.18}.table-shadow{position:absolute;width:74%;height:56%;left:15%;top:34%;border-radius:50%;background:#000;filter:blur(30px);opacity:.45}.wood-table{position:absolute;width:76%;height:57%;left:13%;top:34%;border-radius:50%;background:linear-gradient(145deg,#a9542e,#4e1c11 48%,#9c4727);box-shadow:inset 0 0 0 7px rgba(43,11,5,.7),inset 0 0 0 14px rgba(235,139,70,.18),0 35px 35px rgba(0,0,0,.45);transform:perspective(900px) rotateX(56deg);transform-origin:center}.table-rim{position:absolute;inset:2%;border-radius:50%;border:3px solid rgba(244,187,93,.25)}.table-felt{position:absolute;inset:11%;border-radius:50%;background:radial-gradient(ellipse at center,#19634e,#0b332a 70%);box-shadow:inset 0 0 45px rgba(0,0,0,.5);border:3px solid rgba(120,231,173,.28)}
.arena-top{position:absolute;z-index:30;top:0;left:0;right:0;padding:12px 16px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;background:linear-gradient(180deg,rgba(0,0,0,.65),transparent);pointer-events:none}.arena-top>*{pointer-events:auto}.game-stat{display:grid;gap:2px;color:#d3e8ff}.game-stat span{font-size:8px;letter-spacing:2px;color:#8db1d8}.game-stat b{font-size:13px}.turn-badge{justify-self:center;padding:9px 20px;border-radius:999px;background:linear-gradient(180deg,#2dd8ff,#1678e8);color:#fff;font-size:12px;font-weight:1000;letter-spacing:1px;box-shadow:0 0 28px rgba(49,202,255,.28)}.turn-badge.bot{background:linear-gradient(180deg,#7f91aa,#35435b)}.arena-tools{justify-self:end;display:flex;gap:7px}.arena-tools .icon-btn{background:rgba(0,0,0,.45);backdrop-filter:blur(8px)}
.table-players{position:absolute;z-index:25;inset:55px 0 130px;pointer-events:none}.table-players .opponent-card{position:absolute;display:grid;grid-template-columns:auto 1fr;gap:5px;align-items:center;min-width:125px;padding:7px 10px;border-radius:14px;background:linear-gradient(145deg,rgba(3,13,28,.88),rgba(9,31,55,.78));border:1px solid rgba(143,219,255,.18);box-shadow:0 12px 30px rgba(0,0,0,.4);pointer-events:auto;backdrop-filter:blur(8px)}.table-players .opponent-card:nth-child(1){left:50%;top:2%;transform:translateX(-50%)}.table-players .opponent-card:nth-child(2){left:3%;top:42%}.table-players .opponent-card:nth-child(3){right:3%;top:42%}.table-players .opponent-card:nth-child(n+4){left:50%;bottom:5%;transform:translateX(-50%)}.opponent-avatar{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(145deg,#25b9ef,#103b83);font-size:18px}.opponent-card b{display:block;font-size:10px}.opponent-card small{display:block;color:#9ebddd;font-size:8px}.mini-hand{grid-column:1/-1;display:flex;justify-content:center;gap:-4px}.back-mini{width:22px;height:30px;margin-left:-6px;border-radius:5px;border:2px solid #fff;background:radial-gradient(circle at center,#e92838 0 28%,#0a0b10 29% 100%);font-size:0;box-shadow:0 2px 7px rgba(0,0,0,.5)}
.table-center-3d{position:absolute;z-index:20;left:50%;top:52%;transform:translate(-50%,-50%);display:flex;align-items:center;gap:38px}.deck-area,.discard-area{display:grid;place-items:center;gap:8px}.deck-area b{color:#fff;font-size:9px;background:rgba(0,0,0,.55);padding:3px 7px;border-radius:8px}.draw-stack{background:none;border:0;padding:0;cursor:pointer;filter:drop-shadow(0 18px 13px rgba(0,0,0,.45));transition:.18s}.draw-stack:hover{transform:translateY(-6px) rotate(-2deg)}.draw-stack .uno-card{transform:rotate(-8deg)}.discard-area .big-card{transform:rotate(4deg);cursor:default}.color-indicator{font-size:8px;color:#e5f5ff;font-weight:1000;letter-spacing:1px;background:rgba(0,0,0,.5);padding:5px 8px;border-radius:9px}
.turn-hint{position:absolute;z-index:28;top:66%;left:50%;transform:translateX(-50%);font-size:9px;color:#d3eaff;background:rgba(0,0,0,.45);padding:7px 12px;border-radius:999px;white-space:nowrap;backdrop-filter:blur(8px)}
.player-zone{position:absolute;z-index:40;left:0;right:0;bottom:0;min-height:160px;display:grid;grid-template-rows:auto 1fr;align-items:end;padding:0 3% 10px;background:linear-gradient(0deg,rgba(0,0,0,.74),transparent);pointer-events:none}.player-zone>*{pointer-events:auto}.player-self{display:flex;align-items:center;justify-content:center;gap:20px}.self-profile{display:flex;align-items:center;gap:8px;padding:7px 12px;border-radius:13px;background:rgba(0,0,0,.58);backdrop-filter:blur(8px)}.self-profile b{display:block;font-size:11px}.self-profile small{display:block;color:#76e6ff;font-size:8px}.uno-call{border:0;border-radius:50%;width:58px;height:58px;background:radial-gradient(circle at 35% 28%,#ff6e57,#e1162e 55%,#690914);color:#fff;font-weight:1000;font-size:11px;box-shadow:0 8px 20px rgba(0,0,0,.4),inset 0 2px 5px rgba(255,255,255,.4);cursor:pointer;transition:.18s}.uno-call:hover{transform:scale(1.08) rotate(-5deg)}
.hand-fan-3d{height:112px;display:flex;justify-content:center;align-items:flex-end;gap:0;padding:0 2%;overflow:visible;perspective:1000px}.hand-fan-3d .hand-card{--center:calc((var(--n) - 1)/2);transform:translateY(calc(var(--lift) * -1)) rotate(var(--rot));transform-origin:50% 100%;margin-left:-22px;transition:.2s;position:relative;z-index:calc(20 + var(--i));box-shadow:0 12px 20px rgba(0,0,0,.38)}.hand-fan-3d .hand-card:first-child{margin-left:0}.hand-fan-3d .hand-card:hover{transform:translateY(-28px) rotate(0deg) scale(1.08);z-index:100}.uno-card{width:64px;height:94px;border-radius:10px;border:4px solid #f4f0e8;background:#fff;position:relative;display:grid;place-items:center;box-sizing:border-box;color:#fff;font-weight:1000;text-shadow:0 2px 4px rgba(0,0,0,.45);box-shadow:0 8px 14px rgba(0,0,0,.35);overflow:hidden}.uno-card:before{content:"";position:absolute;inset:12% 5%;border:2px solid rgba(255,255,255,.8);border-radius:50%;transform:rotate(-28deg)}.uno-card i{position:absolute;top:3px;left:5px;font-size:13px;font-style:normal;z-index:2}.uno-card span{font-size:28px;z-index:2}.uno-card em{position:absolute;right:4px;bottom:3px;font-size:6px;font-style:normal;z-index:2;opacity:.85}.card-red{background:linear-gradient(145deg,#ff4654,#a80e20)}.card-yellow{background:linear-gradient(145deg,#ffe65b,#c68b00);color:#2d2200;text-shadow:none}.card-green{background:linear-gradient(145deg,#32e48a,#08743e)}.card-blue{background:linear-gradient(145deg,#4cb7ff,#0752ae)}.card-black{background:radial-gradient(ellipse at center,#e93543 0 25%,#0a0b10 26% 72%,#e93543 73%);color:#fff}.back-card{background:radial-gradient(ellipse at center,#f02b3c 0 24%,#090a10 25% 70%,#f02b3c 71% 100%);color:#fff}.back-card:after{content:"UNO";position:absolute;font-size:19px;font-weight:1000;font-style:italic;transform:rotate(-16deg);color:#ffe96a;z-index:3}
.game-toast{position:absolute;right:15px;bottom:165px;max-width:280px}
.orientation-guard{position:fixed;inset:0;z-index:30000;background:radial-gradient(circle,#0a64c9,#020817 70%);display:grid;place-items:center;align-content:center;text-align:center;padding:30px}.orientation-guard .rotate-phone{font-size:70px;animation:rotatePhone 1.5s ease-in-out infinite}.orientation-guard h2{font-size:32px;margin:8px}.orientation-guard p{color:#a9c8e9;max-width:360px}@keyframes rotatePhone{50%{transform:rotate(90deg) scale(1.05)}}

/* mantém o resto do sistema funcionando, sem alterar o visual das telas fora da partida */
@media(max-width:900px) and (orientation:landscape){.game-stage-3d{grid-template-columns:170px minmax(0,1fr);padding:5px;gap:5px}.game-chat-left{border-radius:13px!important}.table-players{inset:45px 0 105px}.player-zone{min-height:125px}.hand-fan-3d{height:85px}.uno-card{width:50px;height:73px;border-width:3px}.uno-card span{font-size:22px}.uno-card i{font-size:10px}.table-center-3d{gap:20px}.table-players .opponent-card{min-width:95px;padding:5px}.turn-hint{top:69%;font-size:7px}.game-toast{bottom:130px}.platform-card{padding:25px}.platform-options{gap:10px}}
@media(max-width:700px) and (orientation:portrait){.platform-options{grid-template-columns:1fr}.platform-card{padding:24px 17px}.platform-option{min-height:150px}.platform-icon{font-size:42px}}
@media(min-width:1200px){.game-stage-3d{grid-template-columns:270px minmax(900px,1fr);padding:14px;gap:14px}.hand-fan-3d{height:140px}.uno-card{width:74px;height:108px}.table-center-3d{gap:50px}}


/* ===== MESA VIVA 3D — atualização 2026-08-15 ===== */
.game-stage-3d{position:relative;min-height:100%;isolation:isolate}
.game-chat-left{position:relative;z-index:40}
.saloon-map{transition:filter .5s ease,background .5s ease}
.map-medieval{background-image:linear-gradient(rgba(35,12,5,.18),rgba(8,5,3,.55)),radial-gradient(circle at 50% 30%,#f6b65a33,transparent 28%),linear-gradient(145deg,#281008,#6a2e14 48%,#170704);}
.map-pirate{background-image:linear-gradient(rgba(0,10,22,.18),rgba(0,4,12,.55)),radial-gradient(circle at 50% 25%,#4ed7ff22,transparent 30%),linear-gradient(145deg,#041a2b,#123c55 50%,#06111b);}
.map-modern{background-image:linear-gradient(rgba(12,19,35,.08),rgba(5,8,18,.5)),radial-gradient(circle at 65% 30%,#ffffff16,transparent 22%),linear-gradient(145deg,#24364c,#10263d 55%,#09111e);}
#arenaShell[data-map-theme="medieval"] .wood-table{background:linear-gradient(145deg,#7c3d1c,#2c1108 48%,#6a3018);}
#arenaShell[data-map-theme="pirate"] .wood-table{background:linear-gradient(145deg,#6d3c1c,#241208 48%,#4b2712);transform:perspective(900px) rotateX(56deg) rotateZ(-1deg);}
#arenaShell[data-map-theme="modern"] .wood-table{background:linear-gradient(145deg,#4a5662,#161c22 48%,#303943);}
#arenaShell[data-map-theme="pirate"] .table-felt{background:radial-gradient(ellipse at center,#174d42,#092c2c 70%);}
#arenaShell[data-map-theme="modern"] .table-felt{background:radial-gradient(ellipse at center,#263c4d,#121c25 70%);}
.map-decor{position:absolute;inset:0;z-index:2;pointer-events:none;font-size:clamp(24px,3vw,46px);opacity:.8;text-shadow:0 8px 20px #000}
.map-decor .decor{position:absolute;filter:drop-shadow(0 6px 7px #000);animation:decorFloat 4s ease-in-out infinite}
.map-decor .decor-0{left:7%;top:18%}.map-decor .decor-1{right:8%;top:22%;animation-delay:-1s}.map-decor .decor-2{right:16%;bottom:23%;animation-delay:-2s}.map-decor .decor-3{left:18%;bottom:28%;animation-delay:-3s}
@keyframes decorFloat{50%{transform:translateY(-8px) rotate(2deg)}}
.table-players{pointer-events:none;z-index:28}
.opponent-seat{position:absolute!important;display:flex!important;flex-direction:column;align-items:center;min-width:120px;padding:4px 8px!important;background:rgba(2,10,21,.28)!important;border:1px solid rgba(255,255,255,.12)!important;border-radius:18px!important;backdrop-filter:blur(7px);box-shadow:0 12px 30px rgba(0,0,0,.35)!important;pointer-events:none!important;transition:filter .2s,transform .35s}
.opponent-seat.seat-0{left:50%;top:0;transform:translateX(-50%)}
.opponent-seat.seat-1{left:2%;top:38%;transform:translateY(-50%)}
.opponent-seat.seat-2{right:2%;top:38%;transform:translateY(-50%)}
.opponent-seat.seat-3{left:50%;bottom:0;transform:translateX(-50%)}
.opponent-seat.active{filter:brightness(1.25);box-shadow:0 0 30px rgba(72,230,255,.28)!important}
.player-character{width:76px;height:86px;position:relative;display:grid;place-items:end center;transform:translateZ(0)}
.player-character .char-body{transform:scale(.72);transform-origin:bottom center}
.player-nameplate{position:relative;z-index:3;margin-top:-7px;padding:4px 8px;border-radius:999px;background:rgba(0,0,0,.58);white-space:nowrap;text-align:center}
.player-nameplate b{font-size:9px}.player-nameplate small{display:block;color:#a7c9e8;font-size:7px}
.player-seat .mini-hand{margin-top:2px;max-width:95px;opacity:.92}
.player-emote{position:absolute;top:-24px;left:50%;transform:translate(-50%,10px) scale(.4);opacity:0;z-index:15;font-size:38px;filter:drop-shadow(0 4px 6px #000);pointer-events:none}
.player-emote.show{animation:emotePop 2.2s ease forwards}
@keyframes emotePop{0%{opacity:0;transform:translate(-50%,15px) scale(.3)}12%{opacity:1;transform:translate(-50%,-8px) scale(1.2)}28%{transform:translate(-50%,-4px) scale(1)}78%{opacity:1}100%{opacity:0;transform:translate(-50%,-40px) scale(.8)}}
.player-seat.playing .player-character,.player-self.playing .self-profile{animation:playerPlay .65s cubic-bezier(.2,.8,.3,1)}
.player-seat.drawing .player-character,.player-self.drawing .self-profile{animation:playerDraw .7s ease}
.player-seat.typing .player-character,.player-self.typing .self-profile{animation:playerTyping 1s ease-in-out infinite}
.player-seat.typing .player-character:after,.player-self.typing .self-profile:after{content:'📱';position:absolute;bottom:30px;left:50%;font-size:22px;transform:translateX(-50%);animation:phoneType .5s ease-in-out infinite alternate;z-index:20}
@keyframes playerPlay{0%{transform:translateY(0) scale(.95)}45%{transform:translateY(10px) scale(1.08)}100%{transform:translateY(0) scale(1)}}
@keyframes playerDraw{0%{transform:translateX(0)}45%{transform:translateX(-14px) rotate(-4deg)}100%{transform:translateX(0)}}
@keyframes playerTyping{50%{transform:translateY(-3px)}}
@keyframes phoneType{to{transform:translateX(-50%) rotate(-8deg) translateY(-3px)}}
.game-action-layer{position:absolute;inset:0;z-index:80;pointer-events:none;overflow:hidden}
.action-flying-card{position:absolute;left:0;top:0;width:58px;height:84px;border:3px solid #fff;border-radius:11px;display:grid;place-items:center;font-size:25px;font-weight:1000;box-shadow:0 16px 35px #0008;transform:translate(calc(var(--sx) - 29px),calc(var(--sy) - 42px)) rotate(-8deg) scale(.85);opacity:0;transition:transform .72s cubic-bezier(.15,.85,.25,1),opacity .12s ease;z-index:90}
.action-flying-card.go{opacity:1;transform:translate(calc(var(--ex) - 29px),calc(var(--ey) - 42px)) rotate(360deg) scale(1)}
.action-flying-card.draw{transform:translate(calc(var(--sx) - 29px),calc(var(--sy) - 42px)) rotate(12deg) scale(.75)}
.action-flying-card.draw.go{transform:translate(calc(var(--ex) - 29px),calc(var(--ey) - 42px)) rotate(-30deg) scale(.65);opacity:.95}
.played-cards{position:absolute;inset:50% auto auto 50%;width:105px;height:145px;transform:translate(-50%,-50%);pointer-events:none;z-index:2}
.played-mini{position:absolute!important;width:68px!important;height:98px!important;left:50%;top:50%;transform:translate(-50%,-50%) rotate(calc((var(--i) - 2) * 7deg)) translate(calc((var(--i) - 2) * 7px),calc((var(--i) - 2) * -3px));opacity:.8;box-shadow:0 10px 22px #0008}
.played-mini span{font-size:25px!important}
.discard-area{position:relative;z-index:4}
.emote-tray{position:absolute;right:12px;bottom:112px;z-index:50;display:flex;gap:5px;padding:6px;border-radius:999px;background:rgba(2,9,20,.68);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(10px)}
.emote-tray button{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.14);background:#12213a;color:#fff;font-size:17px;cursor:pointer;transition:.15s}
.emote-tray button:hover{transform:translateY(-5px) scale(1.1);background:#1d426b}
.chat-typing{min-height:18px;padding:3px 10px;color:#78dfff;font-size:9px;font-style:italic;background:rgba(25,107,155,.12)}
.game-chat-left .chat-form{position:relative;z-index:2}
@media(max-width:900px) and (orientation:landscape){.game-chat-left{min-width:165px}.opponent-seat{min-width:90px}.player-character{width:58px;height:67px}.player-character .char-body{transform:scale(.56)}.player-nameplate b{font-size:7px}.player-nameplate small{font-size:6px}.emote-tray{right:6px;bottom:95px}.emote-tray button{width:27px;height:27px;font-size:14px}.played-cards{transform:translate(-50%,-48%) scale(.8)}}
@media(max-width:650px) and (orientation:landscape){.game-stage-3d{grid-template-columns:150px minmax(0,1fr)}.opponent-seat.seat-1{left:1%}.opponent-seat.seat-2{right:1%}.emote-tray{gap:2px}.emote-tray button{width:24px;height:24px;font-size:12px}}

/* ===== UNO VELHO - MENU PRINCIPAL 3D V2 ===== */
#appScreen:has(#lobbyView:not(.hidden)) > .topbar{display:none}
.lobby-v2{position:relative;min-height:calc(100vh - 0px);overflow:hidden;padding:22px 24px 92px;background:radial-gradient(circle at 18% 40%,#7a1d20 0,#3d0b12 34%,#16050b 72%,#08030a 100%);isolation:isolate}
.lobby-v2:before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,rgba(255,92,0,.16),transparent 36%,rgba(255,0,70,.08) 70%,transparent);pointer-events:none;z-index:-1}
.menu-bg-scene{position:absolute;inset:0;z-index:-1;overflow:hidden;background:radial-gradient(circle at 50% 92%,rgba(255,107,31,.32),transparent 33%)}
.bg-glow{position:absolute;border-radius:50%;filter:blur(45px);opacity:.45}.glow-a{width:340px;height:340px;left:-80px;bottom:30px;background:#e63923}.glow-b{width:420px;height:420px;right:-120px;top:40px;background:#ff6a00}
.bg-card{position:absolute;width:75px;height:105px;border-radius:11px;border:3px solid #f8f2df;background:linear-gradient(145deg,#ef1e28,#97101a);box-shadow:0 15px 30px #0008;display:grid;place-items:center;color:white;font-size:34px;font-weight:1000;opacity:.16;transform:rotate(-18deg)}.bg-card-a{left:3%;top:36%}.bg-card-b{left:35%;top:13%;transform:rotate(14deg)}.bg-card-c{right:24%;bottom:12%;transform:rotate(-12deg)}
.chase-track{position:absolute;left:5%;right:38%;bottom:7%;height:150px;overflow:hidden;opacity:.72;filter:saturate(.95)}
.chase-old,.chase-mom{position:absolute;bottom:16px;font-size:72px;filter:drop-shadow(0 16px 10px #0009);transform-origin:50% 100%;animation:runAcross 8s linear infinite}.chase-old{left:-100px;animation-delay:0s}.chase-mom{left:-170px;bottom:5px;font-size:66px;animation:runAcross 8s linear infinite 1.1s}.old-cane{position:absolute;left:-2px;top:28px;color:#7b4a2c;font-size:60px;transform:rotate(25deg);z-index:-1}.slipper{position:absolute;right:-18px;top:18px;font-size:35px;transform:rotate(-28deg);animation:slipperSwing .55s ease-in-out infinite alternate}.chase-dust{position:absolute;bottom:9px;width:18px;height:10px;border-radius:50%;background:#d8a97c66;animation:dustRun 1.2s ease-in-out infinite}.dust-a{left:28%;animation-delay:.1s}.dust-b{left:36%;animation-delay:.4s}.dust-c{left:43%;animation-delay:.7s}@keyframes runAcross{0%{transform:translateX(-20vw) translateY(0) rotate(-3deg)}45%{transform:translateX(36vw) translateY(-10px) rotate(2deg)}100%{transform:translateX(82vw) translateY(0) rotate(-2deg)}}@keyframes slipperSwing{to{transform:rotate(25deg) translateY(-8px)}}@keyframes dustRun{50%{transform:scale(1.7);opacity:.9}100%{transform:translateX(60px) scale(.4);opacity:0}}
.menu-top-v2{position:relative;z-index:5;display:grid;grid-template-columns:320px 1fr 320px;align-items:center;gap:24px;max-width:1500px;margin:0 auto}.player-card-v2{display:flex;align-items:center;gap:12px;padding:9px 14px;border-radius:18px;background:linear-gradient(145deg,#250b10dd,#09050be8);border:1px solid #ff8a2c66;box-shadow:0 12px 35px #0007}.menu-avatar{width:56px!important;height:56px!important;min-width:56px}.player-card-info{display:grid;gap:3px}.player-card-info>b{font-size:18px}.player-card-info>span,.player-card-info small{font-size:10px;color:#d8b6aa}.player-card-info strong{color:#ffd45a}.xp-line{width:150px;height:7px;border-radius:99px;background:#190c10;overflow:hidden;border:1px solid #ffffff14}.xp-line span{display:block;height:100%;width:40%;background:linear-gradient(90deg,#ffd21f,#ff5a24);border-radius:inherit}
.brand-3d-v2{text-align:center;line-height:.78;filter:drop-shadow(0 10px 0 #3b0808) drop-shadow(0 18px 22px #000b)}.uno-3d{font-size:clamp(54px,7vw,104px);font-weight:1000;letter-spacing:-.08em;color:#fff1bd;background:linear-gradient(#fff8d7 15%,#ffd65d 48%,#c77719 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-stroke:2px #8e5014;transform:skew(-8deg) rotate(-5deg)}.velho-3d{display:inline-block;margin-top:-6px;padding:8px 22px;font-size:clamp(25px,3vw,46px);font-weight:1000;letter-spacing:.04em;color:#fff;background:linear-gradient(#ff5a40,#a60013);border:3px solid #ffcc72;border-radius:12px;box-shadow:0 8px 0 #56000a,0 12px 20px #0008;transform:skew(-7deg) rotate(-4deg)}.brand-3d-v2>span{display:block;margin-top:13px;font-size:11px;letter-spacing:.48em;color:#6ff4ff;font-weight:1000}
.economy-v2{display:flex;justify-content:flex-end;gap:10px}.economy-v2>div{display:flex;align-items:center;gap:7px;padding:8px 10px 8px 13px;border-radius:16px;background:#1a080bd9;border:1px solid #ffb24a55;box-shadow:inset 0 1px #fff2}.economy-v2 button{border:0;border-radius:10px;background:#5bcf34;color:white;font-size:20px;font-weight:1000;width:30px;height:30px;cursor:pointer}
.menu-main-v2{position:relative;z-index:5;display:grid;grid-template-columns:minmax(220px,.8fr) minmax(430px,1.35fr) 180px;gap:26px;align-items:center;max-width:1500px;margin:24px auto 0}.menu-character-column{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;min-height:500px}.character-platform-v2{position:relative;width:290px;height:380px;display:grid;place-items:end center}.character-platform-v2:before{content:"";position:absolute;bottom:30px;width:260px;height:80px;border-radius:50%;background:radial-gradient(ellipse,#ff9a2b66,transparent 65%);filter:blur(5px)}.platform-ring{position:absolute;bottom:34px;width:245px;height:55px;border-radius:50%;border:3px solid #ffb22f;box-shadow:0 0 35px #ff6d1f66,inset 0 0 25px #ff8a1d55;transform:rotateX(65deg);background:#28110dcc}.menu-character{position:relative;z-index:2;transform:scale(1.65) translateY(-22px);filter:drop-shadow(0 24px 20px #000b)}.edit-skin-v2{position:relative;z-index:4;margin-top:-4px;padding:12px 28px;border-radius:16px;border:2px solid #ffba38;background:linear-gradient(180deg,#3a220d,#160b08);color:#fff;font-size:15px;font-weight:1000;letter-spacing:.04em;box-shadow:0 8px 0 #5d2609,0 15px 25px #0009;cursor:pointer;transition:.18s}.edit-skin-v2:hover{transform:translateY(-3px)}.character-small-action{margin-top:16px;border:1px solid #ffffff22;background:#16090dd9;color:#fff;padding:9px 18px;border-radius:12px;cursor:pointer}
.main-buttons-v2{display:flex;flex-direction:column;gap:15px;max-width:600px}.big-menu-btn{display:grid;grid-template-columns:64px 1fr 42px;align-items:center;text-align:left;min-height:92px;padding:10px 18px;border-radius:24px;border:3px solid #ffffff44;color:#fff;box-shadow:0 10px 0 #0006,0 18px 28px #0008,inset 0 3px 0 #fff6;cursor:pointer;transition:transform .16s ease,filter .16s ease}.big-menu-btn:hover{transform:translateX(5px) translateY(-2px);filter:brightness(1.08)}.big-menu-btn:active{transform:translateY(5px);box-shadow:0 4px 0 #0006,inset 0 2px 0 #fff4}.big-menu-btn .btn-icon{font-size:42px;text-align:center;filter:drop-shadow(0 5px 4px #0008)}.big-menu-btn b{display:block;font-size:29px;line-height:1}.big-menu-btn small{display:block;margin-top:7px;font-size:11px;font-weight:800;letter-spacing:.05em;opacity:.88}.big-menu-btn i{font-style:normal;font-size:48px;text-align:center;text-shadow:0 4px 0 #0005}.big-menu-btn.green{background:linear-gradient(180deg,#83ed4c,#22a72f 58%,#0c6b24);border-color:#b8ff91}.big-menu-btn.blue{background:linear-gradient(180deg,#4edcff,#1673d6 60%,#0b3f9c);border-color:#8defff}.big-menu-btn.gold{background:linear-gradient(180deg,#ffe65b,#e8a817 58%,#9b4f0b);border-color:#fff29c}.big-menu-btn.purple{background:linear-gradient(180deg,#c875ff,#7434c6 60%,#3b176f);border-color:#efb5ff}
.right-rail-v2{display:flex;flex-direction:column;gap:14px;padding:12px 0}.rail-btn{position:relative;display:grid;justify-items:center;gap:7px;padding:18px 8px;border:1px solid #ffbb4d55;border-radius:20px;background:linear-gradient(180deg,#32140fef,#11070aeF);color:#fff;box-shadow:0 12px 25px #0008,inset 0 1px #fff2;cursor:pointer}.rail-btn span{font-size:40px;filter:drop-shadow(0 5px 3px #0009)}.rail-btn b{font-size:11px;letter-spacing:.05em}.rail-btn em{position:absolute;right:8px;top:7px;background:#e82938;border:2px solid #ff9b9b;border-radius:999px;padding:3px 7px;font-style:normal;font-size:10px}
.global-chat-v2{position:fixed;z-index:20;left:50%;bottom:22px;transform:translateX(-50%);width:min(680px,calc(100vw - 420px));display:flex;align-items:center;gap:12px;padding:10px 13px;border-radius:17px;background:#160b0ee8;border:1px solid #ffb64b55;box-shadow:0 12px 30px #000a}.global-dot{font-size:25px}.global-chat-v2 b{color:#8bff32;font-size:11px}.global-chat-v2 p{margin:3px 0 0;font-size:12px;color:#f4dcd6}.global-chat-v2 button{margin-left:auto;border:0;background:#2b1a19;color:white;border-radius:12px;width:42px;height:38px;font-size:20px;cursor:pointer}.menu-status-v2{position:fixed;z-index:10;bottom:3px;left:50%;transform:translateX(-50%);font-size:9px;color:#b9948a;display:flex;gap:8px;white-space:nowrap}
@media(max-width:1050px){.menu-top-v2{grid-template-columns:230px 1fr 230px}.menu-main-v2{grid-template-columns:220px minmax(350px,1fr) 145px;gap:14px}.character-platform-v2{transform:scale(.9)}.big-menu-btn{min-height:78px}.big-menu-btn b{font-size:23px}.global-chat-v2{width:50vw}}
@media(max-width:850px){.lobby-v2{padding:12px 12px 65px}.menu-top-v2{grid-template-columns:1fr auto 1fr;gap:8px}.player-card-v2{padding:6px}.player-card-info small,.player-card-info>span{display:none}.brand-3d-v2 .uno-3d{font-size:54px}.brand-3d-v2 .velho-3d{font-size:24px}.economy-v2{gap:4px}.economy-v2>div{padding:5px;font-size:11px}.menu-main-v2{grid-template-columns:170px minmax(0,1fr) 100px;gap:10px;margin-top:10px}.menu-character-column{min-height:400px}.character-platform-v2{transform:scale(.72);margin-left:-20px}.edit-skin-v2{font-size:11px;padding:9px 12px}.character-small-action{font-size:9px}.big-menu-btn{grid-template-columns:42px 1fr 20px;min-height:68px;border-radius:16px;padding:7px 9px}.big-menu-btn .btn-icon{font-size:27px}.big-menu-btn b{font-size:17px}.big-menu-btn small{font-size:8px;margin-top:3px}.big-menu-btn i{font-size:28px}.rail-btn{padding:10px 3px;border-radius:14px}.rail-btn span{font-size:28px}.rail-btn b{font-size:7px}.global-chat-v2{width:56vw;bottom:15px}.menu-status-v2{display:none}}
@media(max-width:650px) and (orientation:portrait){.lobby-v2{min-height:100dvh;overflow:auto}.menu-top-v2{grid-template-columns:1fr;justify-items:center}.player-card-v2{width:min(340px,92vw)}.economy-v2{justify-content:center}.menu-main-v2{grid-template-columns:1fr;justify-items:center}.menu-character-column{min-height:330px}.main-buttons-v2{width:min(560px,94vw)}.right-rail-v2{width:94vw;display:grid;grid-template-columns:repeat(3,1fr)}.global-chat-v2{position:relative;left:auto;transform:none;width:94vw;margin:15px auto 0}.menu-status-v2{display:none}.chase-track{left:0;right:0}.brand-3d-v2{order:-1}}

/* ================= PERSONALIZAÇÃO 3D / ROUPAS VISUAIS ================= */
.customize-page{padding-bottom:28px}.subnav-subtitle{display:block;color:#7f9fc5;font-size:10px;margin-top:3px}.custom-page-layout{display:grid;grid-template-columns:330px 1fr;gap:16px;align-items:start}.custom-showcase{position:sticky;top:76px;border-radius:26px;padding:20px;min-height:620px;display:grid;place-items:center;align-content:center;gap:10px;background:radial-gradient(circle at 50% 28%,rgba(72,230,255,.18),transparent 35%),linear-gradient(145deg,rgba(14,62,126,.95),rgba(3,14,35,.98));overflow:hidden}.custom-showcase:after{content:"";position:absolute;width:230px;height:55px;bottom:108px;border-radius:50%;background:rgba(0,0,0,.35);filter:blur(18px)}.custom-showcase>*{position:relative;z-index:2}.showcase-badge{font-size:10px;font-weight:1000;letter-spacing:1.5px;color:#8ceeff}.custom-page-character{width:250px!important;height:340px!important;transform:scale(1.08);filter:drop-shadow(0 22px 25px rgba(0,0,0,.45));animation:customFloat 3.5s ease-in-out infinite}.custom-showcase>b{font-size:18px}.owned-counter{font-size:10px;color:#80dfff;background:rgba(72,230,255,.08);border:1px solid rgba(72,230,255,.16);padding:7px 10px;border-radius:999px}.equipped-list{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:5px 0 7px}.equipped-chip{display:flex;gap:7px;align-items:center;padding:8px;border-radius:12px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.06);min-width:0}.equipped-chip>span{font-size:16px}.equipped-chip small{display:block;text-transform:uppercase;color:#6f8fb8;font-size:7px}.equipped-chip b{display:block;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.custom-picker{border-radius:26px;padding:20px;min-height:620px}.custom-picker-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:13px}.custom-picker-head h3{margin:7px 0 0;font-size:22px}.custom-category-tabs{display:flex;gap:7px;overflow-x:auto;padding-bottom:9px;margin-bottom:10px}.custom-cat{white-space:nowrap;padding:10px 13px;border-radius:12px;background:rgba(255,255,255,.045);color:#8aa9cf;font-size:10px;font-weight:950;border:1px solid rgba(255,255,255,.06)}.custom-cat.active{background:linear-gradient(135deg,#0d7dff,#25cfff);color:#fff;border-color:rgba(255,255,255,.25);box-shadow:0 8px 24px rgba(25,134,255,.22)}.skin-strip{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.035);margin-bottom:12px}.skin-strip b{font-size:10px;margin-right:4px}.skin-strip .swatch{flex:none}.custom-catalog{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.custom-item-card{padding:0;overflow:hidden;text-align:left;border-radius:18px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07);transition:transform .16s,border-color .16s,filter .16s;min-width:0}.custom-item-card:hover{transform:translateY(-3px);filter:brightness(1.08)}.custom-item-card.selected{border-color:#44e5ff;box-shadow:0 0 0 2px rgba(68,229,255,.12),0 12px 30px rgba(0,0,0,.22)}.custom-item-card.locked{opacity:.78}.custom-photo{height:145px;position:relative;background:linear-gradient(145deg,#123d7a,#07172f);overflow:hidden}.custom-photo img{width:100%;height:100%;object-fit:cover;display:block}.photo-badge{position:absolute;right:7px;top:7px;padding:6px 7px;border-radius:9px;background:rgba(0,0,0,.65);backdrop-filter:blur(5px);font-size:8px;font-weight:1000;color:#fff}.custom-item-info{padding:10px;display:grid;gap:4px}.custom-item-info>b{font-size:11px}.custom-item-info small{font-size:8px;color:#7f9fc5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.custom-item-info em{font-size:8px;font-style:normal;color:#55e5a0}.custom-item-card.locked .custom-item-info em{color:#ffca65}.custom-note{margin-top:13px;color:#7898bf;font-size:9px;text-align:center}.item-visual{position:relative}.item-visual img{width:100%;height:100%;object-fit:cover;display:block}.item-fallback{display:none;position:absolute;inset:0;place-items:center;font-size:45px}.item-visual img[style*="display: none"]+.item-fallback{display:grid}@keyframes customFloat{0%,100%{transform:scale(1.08) translateY(0)}50%{transform:scale(1.08) translateY(-7px)}}
@media(max-width:900px){.custom-page-layout{grid-template-columns:1fr}.custom-showcase{position:relative;top:auto;min-height:480px}.custom-page-character{height:280px!important}.custom-picker{min-height:0}.custom-catalog{grid-template-columns:repeat(2,minmax(0,1fr))}.custom-photo{height:135px}}
@media(max-width:520px){.custom-picker{padding:14px}.custom-showcase{padding:14px}.custom-category-tabs{margin-right:-5px}.custom-cat{font-size:9px;padding:9px 10px}.custom-catalog{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.custom-photo{height:120px}.equipped-list{grid-template-columns:1fr 1fr}.custom-picker-head h3{font-size:18px}}

/* =========================================================
   UNO VELHO — EXPERIÊNCIA 3D AO VIVO / PRIMEIRA PESSOA v8
   ========================================================= */
.character-3d-container{position:relative;display:grid!important;place-items:center;overflow:visible}.char-3d-live{position:relative;width:100%;height:100%;display:grid;place-items:end center;transform:translateZ(0);animation:avatarIdle 3.6s ease-in-out infinite;filter:drop-shadow(0 24px 24px rgba(0,0,0,.42));isolation:isolate}.char-3d-live>img{width:100%;height:100%;object-fit:contain;object-position:center bottom;user-select:none;-webkit-user-drag:none;transform:perspective(800px) rotateY(var(--avatar-hue));mix-blend-mode:normal}.char-3d-live .char-aura{position:absolute;inset:15% 10% 4%;border-radius:50%;background:radial-gradient(circle,#52eaff33,transparent 62%);filter:blur(16px);z-index:-1;opacity:.8}.char-item-overlays{position:absolute;inset:0;pointer-events:none}.avatar-item-tag{position:absolute;left:50%;transform:translateX(-50%);padding:4px 8px;border-radius:999px;background:#071325dd;border:1px solid #8beaff55;color:#dffaff;font-size:7px;font-weight:1000;white-space:nowrap;box-shadow:0 7px 18px #0008}.top-tag{top:48%}.bottom-tag{top:66%}.acc-tag{top:37%}.player-character .char-3d-live{animation-duration:4.2s}.player-character .char-3d-live>img{object-fit:contain}.player-character .avatar-item-tag{font-size:6px;padding:3px 6px}.self-profile .char-3d-live>img{object-fit:contain}.avatar-game.character-3d-container{width:52px;height:58px}.avatar-mini .char-3d-live,.menu-avatar-button .char-3d-live{width:100%;height:100%}@keyframes avatarIdle{0%,100%{transform:translateY(0) rotateY(0)}50%{transform:translateY(-4px) rotateY(2deg)}}

/* Primeira pessoa: você está sentado na mesa */
.game-view{background:#020509!important}.first-person-stage{grid-template-columns:245px minmax(0,1fr)!important;gap:10px!important;padding:8px!important}.first-person-arena{overflow:hidden!important;background:#070b12!important;border:1px solid #ffffff16!important;box-shadow:0 28px 90px #000!important}.first-person-map{position:absolute!important;inset:0!important;background:#241308!important;overflow:hidden!important}.first-person-map:before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 50% 35%,#ffd98a2c,transparent 36%),linear-gradient(180deg,#20110b 0,#351b0e 36%,#140b08 100%);z-index:0}.far-wall{position:absolute;left:0;right:0;top:0;height:39%;background:linear-gradient(180deg,#4c2816,#201008 72%,#120907);box-shadow:inset 0 -30px 45px #0008;z-index:1}.far-wall:before,.far-wall:after{content:"";position:absolute;top:18%;width:18%;height:55%;background:linear-gradient(90deg,#160b07,#713a1e,#1b0b07);border-radius:6px;box-shadow:0 10px 30px #0009}.far-wall:before{left:4%}.far-wall:after{right:4%}.map-sign{position:absolute;left:50%;top:22%;transform:translateX(-50%) rotate(-1deg);padding:12px 30px;border:4px solid #8a4e22;background:#351709;color:#ffd46c;font:900 22px Georgia,serif;letter-spacing:3px;box-shadow:0 12px 25px #0009;text-shadow:0 3px 0 #000}.map-ceiling-lights{position:absolute;z-index:4;left:8%;right:8%;top:4%;display:flex;justify-content:space-between;pointer-events:none}.map-ceiling-lights i{width:32px;height:46px;border-radius:50%;background:#ffca64;box-shadow:0 0 30px #ffc34c,0 0 80px #ff9e2a88;animation:lampFlicker 2.7s infinite}.map-ceiling-lights i:nth-child(2){animation-delay:-.8s}.map-ceiling-lights i:nth-child(3){animation-delay:-1.7s}@keyframes lampFlicker{50%{opacity:.82;transform:scale(.95)}}
.first-person-table{position:absolute!important;z-index:7;left:50%;top:34%;width:108%;height:79%;transform:translateX(-50%) perspective(950px) rotateX(60deg);transform-origin:center top;border-radius:50%;background:linear-gradient(145deg,#8e4b22,#3a160b 46%,#6e3518);box-shadow:0 -12px 0 #b86b35,0 30px 80px #000d,0 0 0 10px #2a1008;overflow:hidden}.first-person-table .table-rim{position:absolute;inset:0;border-radius:50%;border:10px solid #6e351b;box-shadow:inset 0 0 0 3px #c17b45, inset 0 -20px 30px #0005}.first-person-table .table-felt{position:absolute;inset:9%;border-radius:50%;background:radial-gradient(ellipse at center,#24765e,#155542 54%,#0a2c25 100%);box-shadow:inset 0 0 45px #0009,0 0 0 4px #c18b4a55}.table-grain{position:absolute;inset:0;opacity:.28;background:repeating-linear-gradient(8deg,transparent 0 14px,#f1ad6940 15px 17px,transparent 18px 31px);mix-blend-mode:screen}.table-cup{position:absolute;z-index:10;font-size:46px;transform:rotate(-5deg);filter:drop-shadow(0 12px 8px #0009)}.cup-left{left:17%;top:29%}.cup-right{right:16%;top:27%;transform:rotate(7deg)}
.table-players.first-person-opponents{position:absolute!important;inset:0!important;z-index:22!important}.first-person-opponents .opponent-seat{background:transparent!important;border:0!important;box-shadow:none!important;backdrop-filter:none!important}.first-person-opponents .seat-0{left:50%;top:8%;transform:translateX(-50%)}.first-person-opponents .seat-1{left:12%;top:35%;transform:translateY(-50%) scale(.92)}.first-person-opponents .seat-2{right:12%;top:35%;transform:translateY(-50%) scale(.92)}.first-person-opponents .seat-3{left:50%;top:18%;transform:translateX(-50%) scale(.8)}.first-person-opponents .player-character{width:125px;height:145px;filter:drop-shadow(0 18px 12px #0009)}.first-person-opponents .player-nameplate{font-size:10px;background:#080d16dd;border:1px solid #ffffff22;box-shadow:0 8px 20px #0009}.first-person-opponents .mini-hand{display:flex;justify-content:center;transform:translateY(-3px)}.first-person-opponents .back-mini{width:23px;height:32px;margin-left:-8px;border:2px solid #fff;border-radius:5px;background:radial-gradient(ellipse,#f32c42 0 25%,#090b11 26% 72%,#f32c42 73%);font-size:0;box-shadow:0 4px 6px #0008}.first-person-opponents .active .player-character{animation:opponentTurn 1.15s ease-in-out infinite}.first-person-opponents .playing .player-character{animation:opponentPlay .65s cubic-bezier(.2,.9,.3,1)}.first-person-opponents .drawing .player-character{animation:opponentDraw .7s ease}.first-person-opponents .typing .player-character:after{content:"📱";position:absolute;left:50%;bottom:25%;transform:translateX(-50%);font-size:28px;animation:phoneTyping .45s ease-in-out infinite alternate;filter:drop-shadow(0 5px 5px #000)}@keyframes opponentTurn{50%{transform:translateY(-6px) scale(1.03)}}@keyframes opponentPlay{0%{transform:translateY(0) rotate(0)}45%{transform:translateY(22px) rotate(-4deg) scale(1.08)}100%{transform:translateY(0) rotate(0)}}@keyframes opponentDraw{0%,100%{transform:translateX(0)}45%{transform:translateX(-22px) rotate(-4deg)}}@keyframes phoneTyping{to{transform:translateX(-50%) rotate(-8deg) translateY(-3px)}}

.first-person-center{z-index:35!important;top:54%!important;gap:56px!important;align-items:center}.first-person-center .deck-area small{color:#d7c29b;font-weight:1000;font-size:8px;letter-spacing:1px}.first-person-center .main-discard{position:relative;transform:translateY(-3px)}.center-card{width:118px!important;height:174px!important;border-width:6px!important;border-radius:16px!important;font-size:1.3em!important;box-shadow:0 25px 45px #000b,0 0 0 3px #ffffff22,0 0 35px #ffffff18!important;transform:rotate(2deg)!important}.center-card span{font-size:56px!important;text-shadow:0 5px 10px #0008}.center-card i{font-size:20px!important}.center-card em{font-size:8px!important}.center-card-shadow{position:absolute;inset:20px -18px -22px;border-radius:50%;background:#0009;filter:blur(16px);z-index:-1}.first-person-center .draw-stack .uno-card{width:92px;height:136px;box-shadow:0 20px 35px #000a}.first-person-center .draw-stack:hover{transform:translateY(-9px) rotate(-3deg) scale(1.04)}.played-cards{position:absolute;left:50%;top:50%;transform:translate(45px,-50%);display:flex;align-items:center;z-index:-1;pointer-events:none}.played-mini{width:45px;height:66px!important;margin-left:-30px;opacity:.62;transform:rotate(calc((var(--i) - 2) * 7deg)) translateY(calc(abs(var(--i) - 2) * 3px));font-size:16px}.played-mini span{font-size:17px}.table-status{position:absolute;z-index:45;left:50%;top:67%;transform:translateX(-50%);padding:7px 14px;border-radius:999px;background:#050b13cc;border:1px solid #ffffff1c;color:#d8e9ff;font-size:10px;font-weight:900;box-shadow:0 8px 25px #0008;white-space:nowrap}.game-action-layer{position:absolute;inset:0;z-index:70;pointer-events:none;overflow:hidden}.first-person-hands{position:absolute;z-index:52;left:0;right:0;bottom:-5%;height:34%;pointer-events:none}.fp-arm{position:absolute;bottom:-7%;width:30%;height:82%;background:linear-gradient(135deg,#8b563f,#c98769 50%,#6c3e2e);border-radius:45% 45% 10% 10%;box-shadow:0 20px 35px #0009;filter:drop-shadow(0 12px 12px #0008)}.fp-arm-left{left:18%;transform:rotate(17deg)}.fp-arm-right{right:18%;transform:rotate(-17deg)}.fp-hand{position:absolute;bottom:20%;font-size:clamp(45px,5vw,80px);filter:drop-shadow(0 10px 8px #000);opacity:.95}.fp-hand-left{left:28%;transform:rotate(-18deg)}.fp-hand-right{right:28%;transform:rotate(18deg)}
.first-person-player-zone{min-height:225px!important;z-index:60!important;background:linear-gradient(0deg,#020407ee 0,transparent 80%)!important}.first-person-player-zone .player-self{position:absolute;right:2%;bottom:14%;justify-content:flex-end}.first-person-player-zone .self-profile{background:#050b12dd;border:1px solid #ffffff18}.first-person-player-zone .self-profile .avatar-game{display:none}.first-person-player-zone .hand-fan-3d{height:160px;position:relative;z-index:62;padding-bottom:6px}.first-person-player-zone .hand-fan-3d .hand-card{width:92px;height:132px;margin-left:-30px;border-width:5px;box-shadow:0 20px 35px #000c;transition:transform .16s ease,filter .16s ease}.first-person-player-zone .hand-fan-3d .hand-card:hover{transform:translateY(-38px) rotate(0deg) scale(1.08);filter:brightness(1.12)}.card-selected-to-play{animation:cardCommit .45s cubic-bezier(.2,.9,.2,1)}@keyframes cardCommit{0%{transform:translateY(-8px) scale(1)}45%{transform:translateY(-55px) scale(1.12) rotate(0)}100%{transform:translateY(0) scale(.8);opacity:.15}}
.game-emotes{position:absolute;right:18px;bottom:13px;display:flex;gap:5px;z-index:90;padding:5px;border-radius:16px;background:#050b12cc;border:1px solid #ffffff18}.game-emotes button{width:34px;height:34px;border-radius:10px;background:#ffffff0b;font-size:19px;transition:.15s}.game-emotes button:hover{transform:translateY(-4px) scale(1.08);background:#ffffff18}.player-self .self-emote{position:absolute;left:50%;top:-72px;font-size:48px;z-index:99}.game-chat-typing{font-size:9px;color:#74eaff;padding:7px 9px;background:#06152a;border-radius:10px;margin:5px}.game-chat-left{background:linear-gradient(180deg,#06182fe8,#030812ee)!important;backdrop-filter:none!important}.game-chat-left .chat-messages{scrollbar-width:thin}

/* Map personalities */
#arenaShell[data-map-theme="pirate"] .first-person-map{background:linear-gradient(180deg,#061a2a,#0b2630 38%,#061219)}#arenaShell[data-map-theme="pirate"] .far-wall{background:linear-gradient(180deg,#123e51,#071923 72%,#031016)}#arenaShell[data-map-theme="pirate"] .first-person-table{background:linear-gradient(145deg,#75401f,#2a1209,#553017)}#arenaShell[data-map-theme="pirate"] .first-person-table .table-felt{background:radial-gradient(ellipse,#174c41,#0a2a2a 70%,#061616)}#arenaShell[data-map-theme="medieval"] .first-person-map{background:linear-gradient(180deg,#251007,#5b2b14 38%,#120806)}#arenaShell[data-map-theme="medieval"] .first-person-table{background:linear-gradient(145deg,#6f3519,#241007,#4e2411)}#arenaShell[data-map-theme="modern"] .first-person-map{background:linear-gradient(180deg,#1f3144,#101d2b 45%,#070c12)}#arenaShell[data-map-theme="modern"] .first-person-table{background:linear-gradient(145deg,#55616c,#202830,#343e47)}#arenaShell[data-map-theme="modern"] .first-person-table .table-felt{background:radial-gradient(ellipse,#30495b,#17242d 72%)}

/* Catálogo: a foto mostra SOMENTE a peça escolhida */
.custom-photo.item-only-photo{height:180px!important;background:radial-gradient(circle at 50% 42%,#1e5b94,#09172e)!important;display:grid;place-items:center;padding:16px}.custom-photo.item-only-photo img{width:100%!important;height:100%!important;object-fit:contain!important;filter:drop-shadow(0 15px 13px #0009)}.custom-item-card{background:linear-gradient(145deg,#0a1d3b,#061127)!important;border-color:#6acfff20!important}.custom-item-card:hover{border-color:#55e8ff66!important;transform:translateY(-5px) scale(1.01)}.custom-item-card.selected{border-color:#62efff!important;box-shadow:0 0 0 2px #62efff22,0 18px 35px #0007!important}.custom-item-info{background:#020a16cc}.custom-showcase .char-3d-live{width:100%;height:100%;min-height:420px}.custom-showcase .char-3d-live>img{max-height:460px}.custom-showcase{background:radial-gradient(circle at 50% 35%,#38dfff2c,transparent 28%),linear-gradient(145deg,#0c2e60,#040c1d)!important}.custom-showcase:before{content:"3D • AO VIVO";position:absolute;top:15px;right:15px;padding:6px 9px;border-radius:999px;background:#43e58a18;border:1px solid #43e58a44;color:#74ffb1;font-size:8px;font-weight:1000;letter-spacing:1px}
.item-visual{background:radial-gradient(circle at 50% 45%,#1c568b,#07152b)!important;display:grid;place-items:center}.item-visual img{object-fit:contain!important;padding:8px;filter:drop-shadow(0 14px 12px #0009)}

@media(max-width:900px) and (orientation:landscape){.first-person-stage{grid-template-columns:165px minmax(0,1fr)!important;padding:4px!important}.first-person-center{gap:26px!important;top:48%!important}.center-card{width:82px!important;height:122px!important}.center-card span{font-size:38px!important}.first-person-center .draw-stack .uno-card{width:64px;height:96px}.first-person-player-zone{min-height:160px!important}.first-person-player-zone .hand-fan-3d{height:112px}.first-person-player-zone .hand-fan-3d .hand-card{width:62px;height:90px;margin-left:-20px}.first-person-hands{height:28%}.fp-arm{width:24%}.fp-hand{font-size:42px}.first-person-opponents .player-character{width:88px;height:100px}.first-person-opponents .seat-1{left:7%}.first-person-opponents .seat-2{right:7%}.game-emotes{right:8px;bottom:8px}.game-emotes button{width:28px;height:28px;font-size:16px}.table-status{top:63%;font-size:8px}.custom-photo.item-only-photo{height:145px!important}}
@media(max-width:650px) and (orientation:landscape){.first-person-stage{grid-template-columns:132px minmax(0,1fr)!important}.game-chat-left{font-size:9px}.first-person-opponents .seat-1,.first-person-opponents .seat-2{display:none!important}.first-person-opponents .seat-0{top:7%}.first-person-opponents .player-character{width:78px;height:88px}.center-card{width:70px!important;height:104px!important}.center-card span{font-size:31px!important}.first-person-center{gap:18px!important}.first-person-player-zone .hand-fan-3d .hand-card{width:52px;height:76px;margin-left:-17px}.first-person-player-zone .hand-fan-3d{height:92px}.first-person-hands{height:24%}}

/* ================= NOVOS MODOS / ADIVINHA O DESENHO ================= */
.modes-view{max-width:1400px;margin:0 auto;padding-bottom:40px}.mode-showcase{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.game-mode-card{position:relative;min-height:150px;border:1px solid rgba(255,255,255,.12);border-radius:26px;padding:22px;display:grid;grid-template-columns:74px 1fr auto;gap:18px;align-items:center;text-align:left;color:#fff;background:linear-gradient(145deg,rgba(255,255,255,.08),rgba(255,255,255,.025));box-shadow:0 18px 50px rgba(0,0,0,.28);backdrop-filter:blur(16px);transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}.game-mode-card:hover{transform:translateY(-5px);box-shadow:0 25px 65px rgba(0,0,0,.4);border-color:rgba(255,255,255,.25)}.game-mode-card h3{margin:4px 0 6px;font-size:24px;letter-spacing:.5px}.game-mode-card p{margin:0;color:rgba(255,255,255,.7);font-size:13px;line-height:1.45}.mode-art{width:74px;height:74px;border-radius:22px;display:grid;place-items:center;font-size:42px;background:rgba(255,255,255,.08);box-shadow:inset 0 1px 0 rgba(255,255,255,.16),0 10px 25px rgba(0,0,0,.25)}.mode-pill{display:inline-block;font-size:10px;font-weight:900;letter-spacing:1px;padding:5px 9px;border-radius:999px;background:rgba(255,255,255,.1);color:#cbd5e1}.mode-pill.live{background:rgba(34,197,94,.17);color:#86efac}.mode-uno{grid-column:1/-1;background:radial-gradient(circle at 20% 20%,rgba(34,197,94,.2),transparent 40%),linear-gradient(145deg,rgba(10,90,55,.65),rgba(9,20,28,.8))}.mode-truco{background:radial-gradient(circle at 20% 20%,rgba(239,68,68,.2),transparent 45%)}.mode-damas{background:radial-gradient(circle at 20% 20%,rgba(168,85,247,.18),transparent 45%)}.mode-xadrez{background:radial-gradient(circle at 20% 20%,rgba(59,130,246,.2),transparent 45%)}.mode-draw{background:radial-gradient(circle at 20% 20%,rgba(236,72,153,.22),transparent 45%),linear-gradient(145deg,rgba(75,30,70,.55),rgba(20,20,35,.8))}.mode-actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}.mode-footer-actions{margin-top:18px;display:flex;justify-content:center}.mode-footer-actions .mode-card{min-width:260px}.draw-view{min-height:100vh;background:radial-gradient(circle at 50% 20%,rgba(59,130,246,.1),transparent 35%),#080b12}.draw-shell{width:min(1500px,100%);margin:0 auto;padding:16px}.draw-top{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18px;padding:14px 18px;border-radius:20px}.draw-top h2{margin:3px 0 0}.draw-timer{min-width:82px;text-align:center;font-size:24px;padding:9px 14px;border-radius:16px;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.1)}.draw-stage{display:grid;grid-template-columns:210px minmax(0,1fr) 270px;gap:14px;margin-top:14px;align-items:stretch}.draw-players,.draw-tools,.draw-projector{border-radius:24px;padding:14px}.draw-players h3{margin:4px 0 12px}.draw-player{display:flex;gap:10px;align-items:center;padding:9px;border-radius:14px;background:rgba(255,255,255,.04);margin-bottom:7px}.draw-player.drawing-now{outline:1px solid rgba(34,197,94,.65);background:rgba(34,197,94,.08)}.draw-avatar{font-size:25px}.draw-player b,.draw-player small{display:block}.draw-player small{color:#94a3b8;font-size:10px;margin-top:3px}.projector-head{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:10px}.projector-head span:first-child{font-weight:900}.projector-head span:last-child{font-size:11px;color:#94a3b8}.projector-screen{position:relative;min-height:440px;border-radius:20px;background:#fff;overflow:hidden;border:10px solid #1f2937;box-shadow:inset 0 0 0 2px rgba(0,0,0,.08),0 18px 45px rgba(0,0,0,.35);display:grid;place-items:center}.projector-screen canvas{display:block;width:100%;height:100%;min-height:440px;background:#fff}.projector-empty{text-align:center;color:#94a3b8;display:grid;gap:7px;place-items:center}.projector-empty b{color:#334155;letter-spacing:2px}.draw-word-card,.draw-reveal{margin-top:10px;padding:12px 14px;border-radius:16px;background:linear-gradient(145deg,rgba(34,197,94,.18),rgba(255,255,255,.05));border:1px solid rgba(34,197,94,.3)}.draw-word-card span,.draw-word-card b,.draw-word-card small,.draw-reveal b,.draw-reveal span{display:block}.draw-word-card b{font-size:24px;margin:3px 0}.draw-word-card small{color:#94a3b8;font-size:11px}.draw-reveal{background:rgba(245,158,11,.12);border-color:rgba(245,158,11,.3)}.draw-reveal span{font-size:24px;font-weight:900;margin-top:3px}.palette{display:grid;gap:9px}.palette>b{font-size:13px}.drawPalette,#drawPalette{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.draw-color{width:100%;aspect-ratio:1;border-radius:10px;border:2px solid rgba(255,255,255,.15);background:var(--c);cursor:pointer}.draw-color.active{outline:3px solid #fff;outline-offset:2px}.brush-size{display:grid;gap:5px;margin:14px 0;font-size:12px}.tool-btn{width:100%;padding:11px;border:0;border-radius:12px;background:rgba(255,255,255,.08);color:#fff;cursor:pointer;margin-bottom:8px}.tool-btn.active{background:#2563eb}.tool-btn.danger{background:rgba(239,68,68,.12);color:#fecaca}.draw-guess{margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,.08)}.draw-guess form{display:grid;grid-template-columns:1fr auto;gap:6px;margin-top:8px}.draw-guess input{min-width:0;border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.25);color:#fff;border-radius:11px;padding:10px}.draw-guess button{border:0;border-radius:11px;padding:10px 12px;font-weight:900;background:#22c55e;color:#06110a}.draw-guess-feed{margin-top:10px;max-height:220px;overflow:auto}.guess-line{display:flex;gap:6px;align-items:center;flex-wrap:wrap;padding:6px 0;font-size:11px;color:#cbd5e1;border-bottom:1px solid rgba(255,255,255,.05)}.guess-line b{color:#fff}.guess-line.correct{color:#86efac}.guess-line em{font-style:normal;font-size:9px;font-weight:900}.draw-canvas-wrap{position:relative;margin-top:14px;border-radius:20px;overflow:hidden;background:#fff;border:2px solid rgba(255,255,255,.1);box-shadow:0 15px 40px rgba(0,0,0,.3)}#drawCanvas{display:block;width:100%;height:auto;touch-action:none;background:#fff;cursor:crosshair}.draw-canvas-lock{position:absolute;inset:0;display:grid;place-items:center;background:rgba(15,23,42,.68);backdrop-filter:blur(3px);color:#fff;font-weight:900;font-size:18px;text-align:center;padding:20px}.draw-canvas-lock.hidden{display:none}
@media(max-width:1050px){.draw-stage{grid-template-columns:170px minmax(0,1fr)}.draw-tools{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}.draw-guess{grid-column:1/-1}.draw-projector{min-width:0}.projector-screen,.projector-screen canvas{min-height:360px}.mode-showcase{grid-template-columns:1fr}.mode-uno{grid-column:auto}}
@media(max-width:700px){.draw-shell{padding:8px}.draw-stage{grid-template-columns:1fr}.draw-players{order:2}.draw-projector{order:1}.draw-tools{order:3;grid-template-columns:1fr 1fr}.projector-screen,.projector-screen canvas{min-height:300px}.draw-canvas-wrap{margin-top:10px}.draw-top{grid-template-columns:auto 1fr auto}.draw-top h2{font-size:17px}.game-mode-card{grid-template-columns:58px 1fr auto;padding:15px;min-height:125px}.mode-art{width:58px;height:58px;font-size:31px}.game-mode-card h3{font-size:18px}.mode-actions{grid-column:2/-1;justify-content:flex-start}}

/* ================= CENTRAL DE MODOS ONLINE ================= */
.mode-hub-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:10px 0 22px}.mode-hub-btn{position:relative;display:grid;grid-template-columns:72px 1fr;grid-template-rows:auto auto;column-gap:14px;align-items:center;text-align:left;padding:18px 22px;border:1px solid rgba(255,255,255,.16);border-radius:24px;color:#fff;cursor:pointer;background:linear-gradient(145deg,rgba(255,255,255,.1),rgba(255,255,255,.025));box-shadow:0 18px 45px rgba(0,0,0,.28),inset 0 1px rgba(255,255,255,.12);transition:.2s transform,.2s filter}.mode-hub-btn:hover{transform:translateY(-5px) scale(1.01);filter:brightness(1.08)}.mode-hub-btn>span{grid-row:1/3;font-size:48px;text-align:center;filter:drop-shadow(0 8px 8px #0008)}.mode-hub-btn b{font-size:28px;letter-spacing:1px}.mode-hub-btn small{font-size:11px;color:#b7c7dc;margin-top:3px}.mode-hub-btn.solo{background:radial-gradient(circle at 15% 20%,#7c3aed33,transparent 45%),linear-gradient(145deg,#291c4e,#0c1020)}.mode-hub-btn.online{background:radial-gradient(circle at 15% 20%,#22d3ee3b,transparent 45%),linear-gradient(145deg,#083f55,#07131e)}
.mode-showcase.compact{grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.mode-showcase.compact .game-mode-card{grid-column:auto!important;display:block;min-height:150px;padding:15px;border-radius:20px}.mode-showcase.compact .mode-art{width:54px;height:54px;font-size:30px;margin-bottom:12px}.mode-showcase.compact .game-mode-card h3{font-size:16px;margin:4px 0}.mode-showcase.compact .game-mode-card p{font-size:10px}.mode-pill.room-ready{background:rgba(59,130,246,.16);color:#93c5fd}.online-mode-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;margin-top:20px}.online-mode-card{position:relative;min-height:240px;padding:20px;border:1px solid rgba(255,255,255,.13);border-radius:25px;color:#fff;text-align:left;cursor:pointer;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;background:linear-gradient(145deg,rgba(255,255,255,.09),rgba(255,255,255,.025));box-shadow:0 20px 50px #0006;transition:.2s transform,.2s border-color,.2s filter}.online-mode-card:hover{transform:translateY(-8px) rotateX(2deg);border-color:#ffffff55;filter:brightness(1.1)}.online-mode-card>span{font-size:58px;position:absolute;top:24px;left:24px;filter:drop-shadow(0 10px 8px #0009)}.online-mode-card>b{font-size:25px;letter-spacing:1px}.online-mode-card>small{font-size:11px;color:#b6c5d8;margin-top:4px}.online-mode-card>em{font-style:normal;align-self:flex-start;margin-top:13px;font-size:9px;font-weight:1000;letter-spacing:1.5px;padding:6px 9px;border-radius:999px;background:#ffffff12;border:1px solid #ffffff1a}.online-mode-card.mode-uno{background:radial-gradient(circle at 20% 20%,#22c55e33,transparent 45%),linear-gradient(145deg,#0a3b2c,#071218)}.online-mode-card.mode-draw{background:radial-gradient(circle at 20% 20%,#ec489933,transparent 45%),linear-gradient(145deg,#451d48,#111020)}.online-mode-card.mode-truco{background:radial-gradient(circle at 20% 20%,#ef444433,transparent 45%),linear-gradient(145deg,#491b1b,#160e0e)}.online-mode-card.mode-damas{background:radial-gradient(circle at 20% 20%,#a855f733,transparent 45%),linear-gradient(145deg,#32184c,#11101b)}.online-mode-card.mode-xadrez{background:radial-gradient(circle at 20% 20%,#3b82f633,transparent 45%),linear-gradient(145deg,#152f55,#0a101c)}
@media(max-width:1050px){.mode-showcase.compact{grid-template-columns:repeat(2,minmax(0,1fr))}.online-mode-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:700px){.mode-hub-actions{grid-template-columns:1fr}.mode-showcase.compact{grid-template-columns:1fr 1fr}.online-mode-grid{grid-template-columns:1fr 1fr}.online-mode-card{min-height:190px;padding:15px}.online-mode-card>span{font-size:44px;top:17px;left:17px}.online-mode-card>b{font-size:20px}}
@media(max-width:450px){.mode-showcase.compact,.online-mode-grid{grid-template-columns:1fr}.online-mode-card{min-height:150px}}

/* v9 — modos solo e personagens 100% em código */
.solo-mode-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin:22px 0}.solo-mode-card{min-height:170px;border:1px solid #ffffff1c;border-radius:22px;background:linear-gradient(145deg,#ffffff10,#ffffff03);color:#fff;padding:18px;text-align:left;display:flex;flex-direction:column;justify-content:flex-end;cursor:pointer;transition:.2s transform,.2s border-color,.2s box-shadow}.solo-mode-card:hover,.solo-mode-card.active{transform:translateY(-7px);border-color:#ffffff55;box-shadow:0 18px 45px #0008}.solo-mode-card>span{font-size:50px;margin-bottom:auto}.solo-mode-card>b{font-size:22px}.solo-mode-card small{color:#aebed0;margin-top:4px}.solo-mode-card.mode-uno{background:linear-gradient(145deg,#064e3b,#071218)}.solo-mode-card.mode-draw{background:linear-gradient(145deg,#4a194f,#111020)}.solo-mode-card.mode-truco{background:linear-gradient(145deg,#551515,#160909)}.solo-mode-card.mode-damas{background:linear-gradient(145deg,#3c1a57,#11101b)}.solo-mode-card.mode-xadrez{background:linear-gradient(145deg,#173d66,#09111c)}.solo-difficulty-row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.solo-difficulty-row .difficulty{border:1px solid #ffffff1a;background:#ffffff0a;color:#fff;border-radius:999px;padding:9px 13px;cursor:pointer}.solo-difficulty-row .difficulty.active{background:#2563eb;border-color:#60a5fa}.mode-game-shell{min-height:100%;padding:18px}.mode-game-top{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:14px 18px;border-radius:20px}.mode-turn{font-weight:1000;color:#fbbf24}.mode-game-body{max-width:1050px;margin:20px auto;min-height:550px;display:grid;place-items:center}.mode-game-message{max-width:900px;margin:0 auto;padding:12px 16px;border-radius:14px;text-align:center}.local-draw-board{width:min(1000px,100%);padding:14px;border-radius:20px}.local-draw-toolbar{display:flex;gap:8px;align-items:center;margin-bottom:10px}.local-draw-toolbar span{font-weight:900;margin-right:auto}.local-draw-board canvas{width:100%;border-radius:14px;background:#fff;touch-action:none}.local-reveal{margin-top:10px;padding:15px;border-radius:14px;background:#16a34a;color:#fff;text-align:center;font-size:20px;font-weight:1000}.truco-solo-board{width:min(850px,100%);min-height:520px;border-radius:30px;padding:28px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;background:radial-gradient(circle,#185c3d,#071b15)}.table-opponent{display:flex;flex-direction:column;align-items:center;gap:5px}.solo-code-character{font-size:70px;animation:codeWobble 2.8s ease-in-out infinite}.truco-center{display:flex;flex-direction:column;align-items:center;font-size:70px}.truco-center strong{font-size:28px;color:#fbbf24}.truco-center small{font-size:12px;color:#b7c8d8}.truco-hand{display:flex;gap:10px;justify-content:center}.playing-card-mini{width:90px;height:125px;border-radius:12px;border:2px solid #fff;background:linear-gradient(145deg,#fff,#dbeafe);color:#111827;font-size:24px;font-weight:1000;cursor:pointer;box-shadow:0 12px 25px #0008;transform:rotate(var(--r,0deg));transition:.2s}.playing-card-mini:hover{transform:translateY(-12px) rotate(var(--r,0deg))}.board-solo{padding:16px;border-radius:24px}.board-grid{display:grid;grid-template-columns:repeat(8,1fr);width:min(640px,85vw);aspect-ratio:1;border:8px solid #5b3b22;border-radius:10px;overflow:hidden}.board-cell{border:0;font-size:clamp(20px,5vw,46px);display:grid;place-items:center;cursor:pointer}.board-cell.light{background:#e6c99a}.board-cell.dark{background:#7b4f2c}.board-cell:hover{filter:brightness(1.25)}.board-grid.chess .board-cell{font-size:clamp(20px,5vw,43px)}.code-character svg{width:100%;height:100%;filter:drop-shadow(0 12px 8px #0008)}.code-character{animation:codeBreathe 3.2s ease-in-out infinite;transform-origin:bottom center}.code-character:hover{animation:codeWobble .65s ease-in-out infinite}@keyframes codeBreathe{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-5px) rotate(1deg)}}@keyframes codeWobble{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(4deg)}}
@media(max-width:900px){.solo-mode-grid{grid-template-columns:repeat(2,1fr)}.mode-game-top{flex-wrap:wrap}.mode-game-body{min-height:460px}}


/* ===== POLIMENTO FINAL — MESA / MÃO / PERSONAGEM ===== */
:root{--safe-bottom:max(14px,env(safe-area-inset-bottom));}
.menu-main-v2{align-items:center}
.menu-character-column{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:190px}
.character-platform-v2{position:relative;width:210px;height:265px;display:grid;place-items:end center;isolation:isolate}
.character-platform-v2:before{content:"";position:absolute;bottom:22px;width:170px;height:38px;border-radius:50%;background:radial-gradient(ellipse,rgba(61,231,255,.42),rgba(61,231,255,.04) 60%,transparent 72%);filter:blur(7px);z-index:-1;animation:platformPulse 2.8s ease-in-out infinite}
.platform-ring{position:absolute;bottom:16px;width:170px;height:36px;border:1px solid rgba(97,234,255,.5);border-radius:50%;box-shadow:0 0 35px rgba(53,208,255,.18),inset 0 0 22px rgba(53,208,255,.12);transform:rotateX(65deg);animation:ringSpin 7s linear infinite}
.menu-character{transform:translateY(-8px) scale(1.08);filter:drop-shadow(0 18px 18px rgba(0,0,0,.45));animation:heroFloat 3.6s ease-in-out infinite}
.edit-skin-v2{position:relative;z-index:5;margin-top:-4px}
@keyframes heroFloat{50%{transform:translateY(-17px) scale(1.1)}}
@keyframes platformPulse{50%{transform:scale(1.12);opacity:.72}}
@keyframes ringSpin{to{transform:rotateX(65deg) rotateZ(360deg)}}

/* Mão: sempre baixa, centro da mesa livre. */
.first-person-player-zone{min-height:132px!important;height:clamp(126px,18vh,172px);padding:0 2% calc(var(--safe-bottom) + 2px)!important;background:linear-gradient(0deg,rgba(0,0,0,.76),rgba(0,0,0,.18) 54%,transparent)!important}
.player-self{position:relative;z-index:110;gap:12px;min-height:44px}
.hand-fan-3d{height:clamp(72px,10vh,105px)!important;max-width:min(980px,92vw);margin:0 auto;align-items:flex-end;padding:0!important;transform:translateY(7px)}
.hand-fan-3d .hand-card{width:clamp(45px,4.4vw,67px);height:clamp(68px,7.4vw,98px);margin-left:clamp(-27px,-2.1vw,-13px);border-width:3px;box-shadow:0 10px 18px rgba(0,0,0,.45)}
.hand-fan-3d .hand-card:hover,.hand-fan-3d .hand-card:focus-visible{transform:translateY(-30px) rotate(0deg) scale(1.08);z-index:300}
.turn-hint{top:auto!important;bottom:clamp(135px,19vh,182px)!important}
.game-toast{bottom:clamp(135px,19vh,182px)!important}
.first-person-hands{opacity:.35;transform:scale(.8) translateY(25px);pointer-events:none}

/* Personagens sempre no quadro, nunca cortados. */
.avatar-game,.character-stage{overflow:visible;display:grid;place-items:end center}
.player-character{contain:layout paint;}
.player-character .char-body{filter:drop-shadow(0 7px 8px rgba(0,0,0,.35))}
.player-nameplate{box-shadow:0 5px 18px rgba(0,0,0,.24);border:1px solid rgba(255,255,255,.12)}

/* Chat global realmente discreto/transparente. */
.global-chat-v2{background:rgba(4,11,23,.22)!important;border-color:rgba(255,255,255,.1)!important;backdrop-filter:blur(10px);box-shadow:0 8px 28px rgba(0,0,0,.16)}
.global-chat-v2 p{opacity:.72}

/* Hub de modos mais claro: cada modo mostra Solo + Online. */
.mode-showcase.compact{grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
.game-mode-card{position:relative;overflow:hidden;transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease}
.game-mode-card:hover{transform:translateY(-6px) rotateX(2deg);border-color:rgba(89,231,255,.38);box-shadow:0 20px 50px rgba(0,0,0,.28)}
.game-mode-card:after{content:"SOLO  •  ONLINE";display:block;margin-top:10px;font-size:9px;font-weight:1000;letter-spacing:1px;color:#8cecff;opacity:.8}
.mode-hub-actions{position:relative;z-index:4}

/* Salas: capa visual do modo, sem fotos. */
.room-cover{background-image:radial-gradient(circle at 30% 20%,rgba(255,255,255,.18),transparent 30%),linear-gradient(145deg,rgba(5,12,28,.35),rgba(5,12,28,.9));background-size:auto}

@media(max-width:1100px){.mode-showcase.compact{grid-template-columns:repeat(2,minmax(0,1fr))}.menu-main-v2{grid-template-columns:180px minmax(0,1fr)}.right-rail-v2{display:none}}
@media(max-width:700px){.mode-showcase.compact{grid-template-columns:1fr}.menu-character-column{min-width:0}.character-platform-v2{height:220px;width:170px}.hand-fan-3d{max-width:96vw}.hand-fan-3d .hand-card{width:48px;height:71px;margin-left:-18px}.first-person-player-zone{height:126px;min-height:126px!important}.self-profile{padding:5px 8px}.uno-call{width:48px;height:48px;font-size:9px}.game-toast{bottom:132px!important}.turn-hint{bottom:132px!important}}

/* === MODOS ONLINE: TRUCO / DAMAS / XADREZ === */
.online-mode-board{width:min(1100px,96vw);margin:18px auto;padding:18px;border-radius:28px;background:linear-gradient(145deg,rgba(15,23,42,.92),rgba(30,41,59,.82));box-shadow:0 25px 70px rgba(0,0,0,.35);color:#fff;position:relative;overflow:hidden}
.online-mode-board::before{content:"";position:absolute;inset:-40%;background:radial-gradient(circle,rgba(255,255,255,.07),transparent 55%);animation:modeGlow 7s ease-in-out infinite;pointer-events:none}
@keyframes modeGlow{0%,100%{transform:translate3d(-4%,0,0) rotate(0)}50%{transform:translate3d(4%,2%,0) rotate(8deg)}}
.mode-scorebar,.strategy-head{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.mode-player-chip{display:flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);border-radius:16px}.mode-player-chip span{font-size:22px}.mode-player-chip b{display:block}.mode-player-chip small{display:block;opacity:.7}.truco-bet{margin-left:auto;padding:10px 16px;border-radius:14px;background:rgba(239,68,68,.18);border:1px solid rgba(248,113,113,.35);font-weight:800}.mode-center-table{position:relative;z-index:1;min-height:260px;display:flex;align-items:center;justify-content:center;border-radius:24px;background:radial-gradient(circle at center,#166534 0,#14532d 38%,#0f3b22 70%,#092615 100%);box-shadow:inset 0 0 80px rgba(0,0,0,.4);border:8px solid #4b2e1d}.trick-cards{display:flex;align-items:center;justify-content:center;gap:12px;min-height:150px}.mode-empty{opacity:.6}.mode-hand-row{position:relative;z-index:2;display:flex;justify-content:center;gap:8px;flex-wrap:wrap;padding:20px 8px 8px}.playing-card-big,.playing-card-mini{font:inherit;color:#111;background:linear-gradient(145deg,#fff,#e5e7eb);border:2px solid rgba(0,0,0,.15);border-radius:14px;box-shadow:0 12px 25px rgba(0,0,0,.3);cursor:pointer;transition:.18s transform,.18s box-shadow}.playing-card-big{width:82px;height:118px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:8px;font-size:26px}.playing-card-big span,.playing-card-mini span{font-size:22px}.playing-card-big:hover{transform:translateY(-12px) rotate(-2deg);box-shadow:0 22px 35px rgba(0,0,0,.4)}.playing-card-mini{padding:10px 14px;min-width:74px;display:flex;flex-direction:column;align-items:center}.playing-card-mini small{font-size:9px;opacity:.6;margin-top:4px}.mode-actions{display:flex;justify-content:center;padding:12px}.strategy-head>span{padding:9px 14px;border-radius:999px;background:rgba(34,197,94,.14);border:1px solid rgba(74,222,128,.3);font-weight:800}.strategy-board{position:relative;z-index:1;width:min(680px,92vw);aspect-ratio:1;margin:10px auto 18px;display:grid;grid-template-columns:repeat(8,1fr);border:12px solid #422b1b;border-radius:18px;overflow:hidden;box-shadow:0 25px 50px rgba(0,0,0,.45)}.strategy-cell{border:0;display:flex;align-items:center;justify-content:center;font-size:clamp(26px,5vw,52px);cursor:pointer;transition:.12s transform,.12s filter}.strategy-cell.light{background:#e7d3a5}.strategy-cell.dark{background:#7a4b2b}.strategy-cell:hover{filter:brightness(1.12)}.strategy-cell.selected{outline:4px solid #facc15;outline-offset:-5px;transform:scale(.92);z-index:2}.strategy-help{text-align:center;opacity:.7}.chess-board .strategy-cell.light{background:#e8d7b2}.chess-board .strategy-cell.dark{background:#8b5e3c}.checkers-board .strategy-cell.light{background:#d8c29a}.checkers-board .strategy-cell.dark{background:#4f3425}.checkers-board .strategy-cell.occupied{font-size:clamp(24px,4.8vw,48px)}
@media(max-width:650px){.online-mode-board{padding:10px;border-radius:18px}.mode-center-table{min-height:200px;border-width:5px}.playing-card-big{width:62px;height:92px;font-size:20px}.playing-card-big span{font-size:17px}.strategy-board{border-width:6px}.mode-player-chip{padding:7px 9px}.truco-bet{margin-left:0}}
.mode-player-char{width:42px;height:48px;overflow:hidden;display:flex;align-items:flex-end;justify-content:center}.mode-player-char .char-3d-live{transform:scale(.48);transform-origin:bottom center;width:90px;height:108px;margin-bottom:-24px}.mode-player-char svg{width:90px;height:108px}
/* UNO V2 — chamada rápida e feedback visual */
.uno-call.hidden{display:none!important}.uno-call{position:relative;overflow:hidden}.uno-call:not(.hidden){animation:unoPulse .72s infinite alternate}.uno-call:after{content:"";position:absolute;inset:2px;border-radius:inherit;border:2px solid rgba(255,255,255,.55);transform:scale(calc(.85 + var(--uno-progress,1)*.15));opacity:calc(.25 + var(--uno-progress,1)*.7);pointer-events:none}.uno-call.expired{animation:none;filter:grayscale(.8);opacity:.55}@keyframes unoPulse{from{transform:scale(1) rotate(-2deg);box-shadow:0 8px 20px rgba(0,0,0,.4),0 0 0 rgba(255,40,70,0)}to{transform:scale(1.09) rotate(2deg);box-shadow:0 8px 24px rgba(0,0,0,.4),0 0 28px rgba(255,40,70,.55)}}


/* ===== HOTFIX UNO: MÃO DO JOGADOR SEMPRE VISÍVEL ===== */
.first-person-player-zone{
  position:absolute!important;
  left:0!important;
  right:0!important;
  bottom:0!important;
  height:clamp(138px,20vh,190px)!important;
  min-height:138px!important;
  display:block!important;
  overflow:visible!important;
  z-index:150!important;
  pointer-events:none!important;
  padding:0!important;
  background:linear-gradient(0deg,rgba(0,0,0,.78),rgba(0,0,0,.20) 58%,transparent)!important;
}
.first-person-player-zone>*{pointer-events:auto}
.first-person-player-zone #playerHand{
  position:absolute!important;
  left:50%!important;
  bottom:5px!important;
  transform:translateX(-50%)!important;
  width:min(94%,980px)!important;
  max-width:980px!important;
  height:clamp(92px,13vh,142px)!important;
  min-height:92px!important;
  display:flex!important;
  flex-direction:row!important;
  flex-wrap:nowrap!important;
  justify-content:center!important;
  align-items:flex-end!important;
  gap:0!important;
  overflow:visible!important;
  visibility:visible!important;
  opacity:1!important;
  z-index:220!important;
  padding:0 22px!important;
}
.first-person-player-zone #playerHand .hand-card{
  display:grid!important;
  visibility:visible!important;
  opacity:1!important;
  flex:0 0 auto!important;
  position:relative!important;
  width:clamp(54px,6vw,82px)!important;
  height:clamp(80px,9.5vw,118px)!important;
  margin-left:clamp(-28px,-1.9vw,-14px)!important;
  transform:translateY(calc(var(--lift,0px) * -1)) rotate(var(--rot,0deg))!important;
  z-index:calc(220 + var(--i,0))!important;
  pointer-events:auto!important;
  cursor:pointer!important;
}
.first-person-player-zone #playerHand .hand-card:first-child{margin-left:0!important}
.first-person-player-zone #playerHand .hand-card:hover,
.first-person-player-zone #playerHand .hand-card:focus-visible{
  transform:translateY(-34px) rotate(0deg) scale(1.08)!important;
  z-index:500!important;
  filter:brightness(1.14)!important;
}
.first-person-player-zone .player-self{
  position:absolute!important;
  right:18px!important;
  bottom:calc(clamp(92px,13vh,142px) + 8px)!important;
  z-index:240!important;
}
.first-person-player-zone .game-emotes{
  position:absolute!important;
  right:16px!important;
  bottom:8px!important;
  z-index:250!important;
}
.first-person-player-zone .game-toast{
  position:absolute!important;
  left:50%!important;
  bottom:calc(clamp(92px,13vh,142px) + 8px)!important;
  transform:translateX(-50%)!important;
  z-index:260!important;
}
@media(max-width:900px) and (orientation:landscape){
  .first-person-player-zone{height:132px!important;min-height:132px!important}
  .first-person-player-zone #playerHand{height:92px!important;min-height:92px!important;bottom:3px!important}
  .first-person-player-zone #playerHand .hand-card{width:56px!important;height:82px!important;margin-left:-19px!important}
  .first-person-player-zone .player-self{bottom:98px!important;right:8px!important}
  .first-person-player-zone .game-toast{bottom:96px!important}
}
@media(max-width:650px) and (orientation:landscape){
  .first-person-player-zone{height:116px!important;min-height:116px!important}
  .first-person-player-zone #playerHand{height:82px!important;min-height:82px!important}
  .first-person-player-zone #playerHand .hand-card{width:48px!important;height:70px!important;margin-left:-16px!important}
  .first-person-player-zone .player-self{bottom:86px!important}
  .first-person-player-zone .game-toast{bottom:84px!important}
}
.hand-empty{color:#cfe7ff;background:rgba(2,10,20,.72);border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:8px 14px;font-size:10px;font-weight:900;letter-spacing:.5px;pointer-events:none}

/* ===== UNO FOCUS PACK — leve, compacto e vivo ===== */
.pass-big-btn{border:1px solid rgba(250,204,21,.35);background:linear-gradient(135deg,rgba(245,158,11,.22),rgba(124,58,237,.2));color:#fff;border-radius:16px;padding:10px 14px;font-weight:1000;cursor:pointer;box-shadow:0 10px 25px rgba(0,0,0,.18);transition:.2s transform,.2s box-shadow}.pass-big-btn small{display:block;font-size:9px;opacity:.72;letter-spacing:1px}.pass-big-btn:hover{transform:translateY(-3px) scale(1.02);box-shadow:0 16px 35px rgba(0,0,0,.28)}
.global-chat-button{border:1px solid rgba(255,255,255,.12);color:#fff;cursor:pointer;text-align:left;display:flex;align-items:center;gap:10px;padding:9px 12px!important}.global-chat-button>span:nth-child(2){display:flex;flex-direction:column;min-width:0}.global-chat-button b{font-size:11px;letter-spacing:.7px}.global-chat-button small{font-size:9px;opacity:.62;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px}.global-chat-button i{margin-left:auto;font-style:normal}.game-chat-left{position:absolute!important;left:10px!important;top:58px!important;width:min(280px,34vw)!important;height:min(330px,46vh)!important;z-index:500!important;background:rgba(4,11,23,.72)!important;backdrop-filter:blur(14px)!important;border-radius:16px!important;box-shadow:0 16px 40px rgba(0,0,0,.38)!important}.game-chat-left.hidden{display:none!important}.game-chat-left .chat-head{padding:8px 10px;font-size:10px}.game-chat-left .chat-head button{border:0;background:transparent;color:#fff;font-size:18px;cursor:pointer}.game-chat-left .chat-messages{height:calc(100% - 74px);font-size:10px;padding:8px}.game-chat-left .chat-form{padding:7px}.game-chat-left .chat-form input{font-size:11px}.game-global-chat-toggle{position:absolute;left:10px;top:58px;z-index:490;width:42px;height:42px;border-radius:13px;border:1px solid rgba(255,255,255,.14);background:rgba(4,11,23,.52);backdrop-filter:blur(10px);color:#fff;font-size:19px;cursor:pointer;box-shadow:0 10px 28px rgba(0,0,0,.25);transition:.2s transform,.2s box-shadow}.game-global-chat-toggle:hover,.game-global-chat-toggle.has-message{transform:scale(1.08);box-shadow:0 0 22px rgba(34,211,238,.35)}.game-global-chat-toggle.has-message::after{content:'';position:absolute;right:-2px;top:-2px;width:9px;height:9px;border-radius:50%;background:#22c55e;box-shadow:0 0 10px #22c55e}
.chat-tabs{display:none!important}.global-chat-v2{position:relative;z-index:20}.global-chat-v2 p{display:none!important}
.generated-item-visual{position:relative;display:grid!important;place-items:center;background:radial-gradient(circle at 35% 25%,hsl(var(--item-hue,210) 90% 70%/.32),transparent 35%),linear-gradient(145deg,rgba(255,255,255,.13),rgba(255,255,255,.03));overflow:hidden}.generated-item-visual::after{content:'';position:absolute;inset:16%;border:1px solid rgba(255,255,255,.16);border-radius:24px;transform:rotate(-8deg);pointer-events:none}.generated-item-visual>span:first-child{font-size:54px;filter:drop-shadow(0 10px 10px rgba(0,0,0,.35));z-index:1}.custom-photo.generated-item-visual{height:145px!important;border-radius:18px}.custom-photo.generated-item-visual .photo-badge{position:absolute;right:8px;bottom:8px;z-index:2}
.char-3d-live.aura-blue .char-aura{box-shadow:0 0 28px 8px rgba(34,211,238,.45)}.char-3d-live.aura-gold .char-aura{box-shadow:0 0 28px 8px rgba(250,204,21,.45)}.char-3d-live.aura-rainbow .char-aura{box-shadow:0 0 32px 10px rgba(236,72,153,.38),0 0 60px 18px rgba(34,211,238,.2)}.char-aura{position:absolute;inset:12% 14% 2%;border-radius:50%;pointer-events:none;animation:charAuraPulse 2.6s ease-in-out infinite}.code-character{position:relative}.code-character svg{position:relative;z-index:2}@keyframes charAuraPulse{0%,100%{transform:scale(.9);opacity:.55}50%{transform:scale(1.08);opacity:1}}
.pass-hero{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:22px;border-radius:24px;margin-bottom:14px}.pass-hero h3{margin:8px 0 4px;font-size:clamp(22px,3vw,34px)}.pass-hero p{margin:0;color:#a9b9ca;max-width:650px}.pass-level-big{text-align:center;min-width:110px;padding:12px 18px;border-radius:20px;background:linear-gradient(145deg,rgba(250,204,21,.2),rgba(124,58,237,.15));border:1px solid rgba(250,204,21,.25)}.pass-level-big small,.pass-level-big span{display:block;font-size:9px;opacity:.65}.pass-level-big b{display:inline-block;font-size:44px;line-height:1}.pass-progress{padding:14px 18px;border-radius:18px;margin-bottom:16px}.pass-progress-head{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin-bottom:8px}.pass-progress-track{height:12px;border-radius:999px;background:rgba(255,255,255,.08);overflow:hidden}.pass-progress-track i{display:block;height:100%;width:0;border-radius:inherit;background:linear-gradient(90deg,#22c55e,#06b6d4,#a855f7);box-shadow:0 0 18px rgba(34,211,238,.35);transition:width .45s ease}.pass-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;padding-bottom:30px}.pass-card{position:relative;min-height:180px;border:1px solid rgba(255,255,255,.1);border-radius:18px;padding:12px;background:linear-gradient(145deg,rgba(255,255,255,.08),rgba(255,255,255,.025));display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:5px;transition:.2s transform,.2s border-color,.2s filter}.pass-card.unlocked:hover{transform:translateY(-5px);border-color:rgba(96,165,250,.5)}.pass-card.locked{filter:saturate(.35) brightness(.65)}.pass-card.claimed{opacity:.62}.pass-level{position:absolute;left:9px;top:8px;font-weight:1000;font-size:11px;opacity:.7}.pass-reward-icon{font-size:38px;margin-top:5px}.pass-card b{font-size:15px}.pass-card small{color:#aebed0;font-size:10px;max-width:130px}.pass-claim{margin-top:7px;padding:7px 10px!important;font-size:9px!important}.btn-owned{background:rgba(255,255,255,.08)!important;color:#94a3b8!important;border-color:rgba(255,255,255,.1)!important}
.first-person-player-zone #playerHand .hand-card{--card-base-y:0px;will-change:transform,filter}.first-person-player-zone #playerHand .hand-card:active{transform:translateY(-24px) rotate(0deg) scale(1.06)!important}.first-person-player-zone #playerHand .hand-card.card-selected-to-play{animation:cardThrow .45s ease forwards!important}@keyframes cardThrow{to{transform:translateY(-70px) scale(1.12) rotate(0deg);opacity:.1}}
#gameActionLayer .fly-card{filter:drop-shadow(0 12px 18px rgba(0,0,0,.45));animation:flyGlow .55s ease-out}@keyframes flyGlow{0%{filter:brightness(1) drop-shadow(0 0 0 rgba(255,255,255,0))}50%{filter:brightness(1.5) drop-shadow(0 0 18px rgba(255,255,255,.5))}100%{filter:brightness(1) drop-shadow(0 12px 18px rgba(0,0,0,.45))}}
@media(max-width:900px){.pass-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.game-chat-left{width:min(250px,48vw)!important}.pass-hero{padding:16px}.pass-level-big{min-width:88px}.pass-level-big b{font-size:34px}}
@media(max-width:650px){.pass-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.pass-card{min-height:155px;padding:9px}.pass-reward-icon{font-size:30px}.game-chat-left{left:6px!important;top:48px!important;width:230px!important;height:270px!important}.game-global-chat-toggle{left:6px;top:48px}.global-chat-button small{max-width:120px}.pass-hero{align-items:flex-start}.pass-hero p{font-size:11px}.pass-big-btn{padding:8px 10px;font-size:10px}}
.global-chat-panel{position:fixed;left:14px;top:76px;width:min(330px,calc(100vw - 28px));height:min(390px,62vh);z-index:10000;background:rgba(4,11,23,.88)!important;backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.13);border-radius:18px;box-shadow:0 24px 60px rgba(0,0,0,.45);overflow:hidden}.global-chat-panel.hidden{display:none!important}.global-chat-panel .chat-head{display:flex;align-items:center;justify-content:space-between;padding:11px 13px;border-bottom:1px solid rgba(255,255,255,.08)}.global-chat-panel .chat-head button{border:0;background:transparent;color:#fff;font-size:22px;cursor:pointer}.global-chat-panel .chat-messages{height:calc(100% - 105px);overflow:auto;padding:10px}.global-chat-panel .chat-form{display:flex;gap:6px;padding:8px;border-top:1px solid rgba(255,255,255,.08)}.global-chat-panel .chat-form input{min-width:0;flex:1}.global-chat-panel .chat-form button{width:40px;border-radius:11px;border:0;background:#2563eb;color:#fff;font-weight:900}@media(max-width:650px){.global-chat-panel{left:8px;top:58px;width:250px;height:290px}.global-chat-panel .chat-messages{font-size:10px}}

.ui-busy{cursor:progress}.ceo-modal{max-width:1100px}.ceo-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:14px}.ceo-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ceo-users{max-height:55vh;overflow:auto;display:grid;gap:7px}.ceo-user-row{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px;border:1px solid rgba(150,210,255,.12);border-radius:12px;background:rgba(0,0,0,.18)}.ceo-user-row small{display:block;color:#8ca9cc}.ceo-user-actions{display:flex;gap:6px}.ceo-user-actions button{font-size:10px;padding:7px 9px;border-radius:9px;background:rgba(72,230,255,.1);color:#b8f5ff;border:1px solid rgba(72,230,255,.2)}.ceo-rail{border-color:rgba(255,211,73,.35)!important}@media(max-width:800px){.ceo-grid,.ceo-actions{grid-template-columns:1fr}.ceo-user-row{align-items:flex-start;flex-direction:column}.ceo-user-actions{width:100%}.ceo-user-actions button{flex:1}}

/* FINAL UX PATCH 2026-08-16 */
.platform-screen:not(.hidden){display:grid!important}
.ceo-rail{display:none;position:relative!important}
.ceo-rail[hidden]{display:none!important}
.pass-view{position:relative;z-index:2}
.pass-grid{padding-bottom:90px}
.item-generated-icon{font-size:58px;filter:drop-shadow(0 12px 18px rgba(0,0,0,.35))}
.item-rarity{position:absolute;right:8px;top:8px;font-size:8px;font-weight:1000;padding:5px 7px;border-radius:999px;background:#071325cc;color:#dffaff}
.item-buy-btn:disabled{opacity:.6;cursor:not-allowed}
.inventory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:10px}
.inventory-item{padding:12px;display:grid;gap:7px;min-width:0}
.inventory-item-icon{height:90px;display:grid;place-items:center;font-size:48px;background:radial-gradient(circle,rgba(72,230,255,.18),transparent 65%);border-radius:14px}
.inventory-item>b{font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.inventory-item>small{font-size:8px;color:#88a6cc}
.inventory-item .btn{font-size:9px;padding:8px}
.pass-card{position:relative;min-width:0;padding:12px;display:grid;gap:7px;align-content:start;border:1px solid rgba(255,255,255,.08);transition:.18s transform,.18s filter}
.pass-card.unlocked{border-color:rgba(71,229,255,.22)}
.pass-card.claimed{opacity:.65}
.pass-card.locked{filter:saturate(.6);opacity:.78}
.pass-level{font-size:9px;color:#7ddfff;font-weight:1000}
.pass-reward-icon{font-size:38px;text-align:center;padding:8px}
.pass-card>b{font-size:10px;min-height:25px}
.pass-card>small{font-size:9px;color:#a7c3e4}
.pass-card .btn{font-size:8px;padding:8px}
@media(max-width:760px){.inventory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.platform-card{width:min(100%,520px)}}
